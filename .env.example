# Copy this file to .env.local (same folder) and fill in the values from
# Supabase → Project Settings → API.   .env.local is never uploaded to GitHub.

# Project URL and the PUBLIC "anon" key — safe to use in the website (security rules protect the data)
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# SECRET "service_role" key — office PC only, for migration/backup/restore scripts.
# It bypasses all security rules: never put it in website code, GitHub, e-mail or chat.
SUPABASE_SERVICE_ROLE_KEY=

# Website data source for maid profiles: "files" (current system) or "supabase" (database)
PUBLIC_MAIDS_SOURCE=files

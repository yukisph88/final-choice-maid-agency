---
// Candidate directory. Every published profile is rendered as static HTML (crawlable,
// works without JavaScript). Filtering, code/name search and pagination run in the browser
// and do not create new URLs, so filters never produce duplicate indexable pages.
import MaidCard from './MaidCard.astro';
import Icon from './Icon.astro';
import { whatsappLink } from '../lib/urls';
import type { Maid } from '../lib/maids';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
interface Props { maids: Maid[]; lang: Lang; nationality?: 'indonesian' | 'filipino'; waMessage?: string; pageSize?: number }
const { maids, lang, nationality, waMessage, pageSize = 12 } = Astro.props;
const T = t(lang);
const D = T.dir;
const wa = waMessage ?? T.wa.home;
// Strings used by the browser script (kept in the page so the script needs no translation logic)
const i18n = JSON.stringify({
  profile: D.profile, profiles: D.profiles, pageOf: D.pageOf(999, 888), prev: D.prev, next: D.next,
  prevLabel: D.prevLabel, nextLabel: D.nextLabel, pageLabel: D.pageLabel,
});
const count = `${maids.length} ${maids.length === 1 ? D.profile : D.profiles}`;
---
{maids.length === 0 ? (
  <div class="empty-state">
    <Icon name="file" size={40} />
    <h2>{D.emptyTitle}</h2>
    <p>{D.emptyText}</p>
    <a class="btn btn--wa" href={whatsappLink(wa)} target="_blank" rel="noopener" data-track="directory_empty">
      <Icon name="whatsapp" size={18} /> {D.emptyBtn}
    </a>
  </div>
) : (
  <div class="directory" data-directory data-page-size={pageSize} data-i18n={i18n}>
    <form class="filters" aria-label={D.filterLabel} data-filters onsubmit="return false">
      <div class="filters__row">
        <div class="field field--search">
          <label for="f-code">{D.searchCode}</label>
          <div class="input-icon"><Icon name="search" size={18} /><input id="f-code" name="code" type="search" placeholder="MA192 / Siti" autocomplete="off" /></div>
        </div>
        {!nationality && (
          <div class="field">
            <label for="f-nat">{D.nationality}</label>
            <select id="f-nat" name="nationality">
              <option value="">{D.all}</option>
              <option value="indonesian">{T.nationality.indonesian}</option>
              <option value="filipino">{T.nationality.filipino}</option>
            </select>
          </div>
        )}
        <div class="field">
          <label for="f-exp">{D.experience}</label>
          <select id="f-exp" name="exp">
            <option value="0">{D.any}</option>
            <option value="1">{D.yearsPlus(1)}</option>
            <option value="3">{D.yearsPlus(3)}</option>
            <option value="5">{D.yearsPlus(5)}</option>
          </select>
        </div>
        <div class="field">
          <label for="f-status">{D.availability}</label>
          <select id="f-status" name="status">
            <option value="">{D.allStatuses}</option>
            <option value="available">{T.status.available}</option>
            <option value="on-hold">{T.status['on-hold']}</option>
            <option value="booked">{T.status.booked}</option>
            <option value="pending-arrival">{T.status['pending-arrival']}</option>
            <option value="unconfirmed">{T.status.unconfirmed}</option>
          </select>
        </div>
      </div>
      <fieldset class="filters__skills">
        <legend>{D.experienceWith}</legend>
        <label class="check"><input type="checkbox" name="childcare" /> {T.skill.childcare}</label>
        <label class="check"><input type="checkbox" name="elderly" /> {T.skill.elderlyCare}</label>
        <label class="check"><input type="checkbox" name="cooking" /> {T.skill.cooking}</label>
        <label class="check"><input type="checkbox" name="housekeeping" /> {T.skill.housekeeping}</label>
        <button class="link-btn" type="reset">{D.clear}</button>
      </fieldset>
    </form>

    <p class="directory__count" aria-live="polite" data-count>{count}</p>

    <div class="maid-grid" data-grid>
      {maids.map((m) => <MaidCard maid={m} lang={lang} />)}
    </div>

    <div class="empty-state empty-state--inline" data-no-results hidden>
      <h2>{D.noMatchTitle}</h2>
      <p>{D.noMatchText}</p>
      <a class="btn btn--wa" href={whatsappLink(wa)} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> {T.btn.whatsappConsultant}</a>
    </div>

    <nav class="pagination" aria-label={D.pagesLabel} data-pagination hidden></nav>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-directory]').forEach((root) => {
    const L = JSON.parse(root.dataset.i18n || '{}');
    const form = root.querySelector<HTMLFormElement>('[data-filters]')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-maid]'));
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-no-results]')!;
    const pager = root.querySelector<HTMLElement>('[data-pagination]')!;
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const size = Number(root.dataset.pageSize) || 12;
    let page = 1;

    const val = (n: string) => form.elements.namedItem(n) as HTMLInputElement | null;

    function matches(c: HTMLElement) {
      const d = c.dataset;
      if (d.gone) return false; // placed / unavailable / withdrawn since the last website build (live status)
      const code = (val('code')?.value || '').trim().toLowerCase();
      if (code && !d.code!.includes(code) && !(d.name || '').includes(code)) return false; // reference code or shown name
      const nat = val('nationality')?.value;
      if (nat && d.nationality !== nat) return false;
      if (Number(d.exp) < Number(val('exp')?.value || 0)) return false;
      const st = val('status')?.value;
      if (st && d.status !== st) return false;
      for (const k of ['childcare', 'elderly', 'cooking', 'housekeeping']) {
        if (val(k)?.checked && d[k] !== '1') return false;
      }
      return true;
    }

    function render(scroll = false) {
      const hits = cards.filter(matches);
      const pages = Math.max(1, Math.ceil(hits.length / size));
      page = Math.min(page, pages);
      cards.forEach((c) => (c.hidden = true));
      hits.slice((page - 1) * size, page * size).forEach((c) => (c.hidden = false));
      const pageText = pages > 1 ? ` · ${String(L.pageOf).replace('999', String(page)).replace('888', String(pages))}` : '';
      count.textContent = `${hits.length} ${hits.length === 1 ? L.profile : L.profiles}${pageText}`;
      empty.hidden = hits.length > 0;
      pager.hidden = pages < 2;
      pager.innerHTML = '';
      if (pages > 1) {
        const mk = (label: string, p: number, opts: { current?: boolean; disabled?: boolean; aria?: string } = {}) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = label;
          if (opts.aria) b.setAttribute('aria-label', opts.aria);
          if (opts.current) b.setAttribute('aria-current', 'page');
          b.disabled = !!opts.disabled;
          b.addEventListener('click', () => { page = p; render(true); });
          pager.appendChild(b);
        };
        mk(L.prev, page - 1, { disabled: page === 1, aria: L.prevLabel });
        for (let p = 1; p <= pages; p++) mk(String(p), p, { current: p === page, aria: `${L.pageLabel} ${p}` });
        mk(L.next, page + 1, { disabled: page === pages, aria: L.nextLabel });
      }
      if (scroll) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    form.addEventListener('input', () => { page = 1; render(); });
    document.addEventListener('maids:live-status', () => render());
    form.addEventListener('reset', () => setTimeout(() => { page = 1; render(); }));
    render();
  });
</script>

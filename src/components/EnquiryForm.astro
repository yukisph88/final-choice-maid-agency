---
// Enquiry form. GitHub Pages has no server, so by default the form composes a WhatsApp
// message (in the page's language) and opens WhatsApp; the visitor then presses Send.
// It never claims an enquiry was "received" unless an optional form service (site.yaml → forms) confirms receipt.
import Icon from './Icon.astro';
import { site } from '../lib/config';
import { href } from '../lib/urls';
import { path, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
interface Props { lang: Lang; defaultNationality?: 'indonesian' | 'filipino' | ''; defaultNeed?: number; idPrefix?: string }
const { lang, defaultNationality = '', defaultNeed = -1, idPrefix = 'enq' } = Astro.props;
const F = t(lang).form;
const id = (s: string) => `${idPrefix}-${s}`;
const usesService = Boolean(site.forms.endpoint);
const i18n = JSON.stringify({
  errName: F.errName, errPhone: F.errPhone, errConsent: F.errConsent, opened: F.opened, sending: F.sending, received: F.received, failed: F.failed,
  intro: F.msgIntro, lName: F.lName, lContact: F.lContact, lNat: F.lNat, lNeed: F.lNeed, lMethod: F.lMethod, lMsg: F.lMsg,
});
---
<form class="enquiry-form" novalidate data-enquiry data-wa={site.contact.whatsappNumber} data-endpoint={site.forms.endpoint} data-key={site.forms.accessKey} data-i18n={i18n}>
  <div class="form-grid">
    <div class="field">
      <label for={id('name')}>{F.name} <span class="req" aria-hidden="true">*</span></label>
      <input id={id('name')} name="name" type="text" autocomplete="name" required maxlength="80" aria-describedby={id('name-err')} />
      <p class="field__error" id={id('name-err')} data-error-for="name"></p>
    </div>
    <div class="field">
      <label for={id('phone')}>{F.phone} <span class="req" aria-hidden="true">*</span></label>
      <input id={id('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder={F.phonePh} aria-describedby={id('phone-err')} />
      <p class="field__error" id={id('phone-err')} data-error-for="phone"></p>
    </div>
    <div class="field">
      <label for={id('nat')}>{F.nationality}</label>
      <select id={id('nat')} name="nationality">
        <option value="" selected={!defaultNationality}>{F.noPref}</option>
        <option value={F.indonesian} selected={defaultNationality === 'indonesian'}>{F.indonesian}</option>
        <option value={F.filipino} selected={defaultNationality === 'filipino'}>{F.filipino}</option>
      </select>
    </div>
    <div class="field">
      <label for={id('need')}>{F.need}</label>
      <select id={id('need')} name="need">
        <option value="" selected={defaultNeed < 0}>{F.choose}</option>
        {F.needs.map((o, i) => <option selected={defaultNeed === i}>{o}</option>)}
      </select>
    </div>
    <fieldset class="field field--full field--radios">
      <legend>{F.method}</legend>
      <label class="check"><input type="radio" name="method" value={F.methodWa} checked /> {F.methodWa}</label>
      <label class="check"><input type="radio" name="method" value={F.methodCall} /> {F.methodCall}</label>
    </fieldset>
    <div class="field field--full">
      <label for={id('msg')}>{F.message}</label>
      <textarea id={id('msg')} name="message" rows="4" maxlength="1000" placeholder={F.messagePh}></textarea>
    </div>
    <div class="hp" aria-hidden="true">
      <label for={id('website')}>{F.honeypot}</label>
      <input id={id('website')} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <div class="field field--full">
      <label class="check check--consent">
        <input type="checkbox" name="consent" required aria-describedby={id('consent-err')} />
        <span>{F.consentA} <a href={href(path(lang, 'privacy'))}>{F.privacy}</a>. <span class="req" aria-hidden="true">*</span></span>
      </label>
      <p class="field__error" id={id('consent-err')} data-error-for="consent"></p>
    </div>
  </div>
  <button class="btn btn--wa btn--lg" type="submit">
    <Icon name="whatsapp" size={20} /> {usesService ? F.submit : F.submitWa}
  </button>
  <p class="form-hint">{usesService ? F.hint : F.hintWa}</p>
  <div class="form-status" role="status" aria-live="polite" data-status></div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-enquiry]').forEach((form) => {
    const L = JSON.parse(form.dataset.i18n || '{}');
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const err = (name: string, msg: string) => {
      const el = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const input = form.elements.namedItem(name) as HTMLInputElement | null;
      if (el) el.textContent = msg;
      input?.setAttribute('aria-invalid', msg ? 'true' : 'false');
      return !msg;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const v = (k: string) => String(fd.get(k) ?? '').trim();
      if (v('website')) return; // spam bot filled the hidden field

      const phoneDigits = v('phone').replace(/[^\d+]/g, '');
      const ok = [
        err('name', v('name').length >= 2 ? '' : L.errName),
        err('phone', /^\+?\d{9,13}$/.test(phoneDigits) ? '' : L.errPhone),
        err('consent', fd.get('consent') ? '' : L.errConsent),
      ].every(Boolean);
      if (!ok) {
        (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus();
        return;
      }

      const lines = [
        L.intro,
        `${L.lName}: ${v('name')}`,
        `${L.lContact}: ${v('phone')}`,
        v('nationality') && `${L.lNat}: ${v('nationality')}`,
        v('need') && `${L.lNeed}: ${v('need')}`,
        `${L.lMethod}: ${v('method')}`,
        v('message') && `${L.lMsg}: ${v('message')}`,
      ].filter(Boolean) as string[];

      const endpoint = form.dataset.endpoint;
      if (endpoint) {
        status.textContent = L.sending;
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ access_key: form.dataset.key, subject: 'Website enquiry – Final Choice', botcheck: '', ...Object.fromEntries(fd), summary: lines.join('\n') }),
          });
          if (!res.ok) throw new Error(String(res.status));
          status.textContent = L.received;
          form.reset();
        } catch {
          status.textContent = L.failed;
        }
        return;
      }

      window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
      status.textContent = L.opened;
      (window as unknown as { dataLayer?: object[] }).dataLayer?.push({ event: 'form_whatsapp_handoff', need: v('need'), nationality: v('nationality') });
    });
  });
</script>

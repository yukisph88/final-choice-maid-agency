---
import { faq } from '../lib/config';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang; homeOnly?: boolean; headingLevel?: 'h2' | 'h3' }
const { lang, homeOnly = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const items = (homeOnly ? faq.filter((f) => f.home) : faq).map((f) => f[lang]);
---
<div class="faq">
  {items.map((f) => (
    <details class="faq__item">
      <summary><H class="faq__q">{f.q}</H></summary>
      <div class="faq__a"><p>{f.a}</p></div>
    </details>
  ))}
</div>

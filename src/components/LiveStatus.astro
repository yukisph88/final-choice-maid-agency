---
// Live availability for the static GitHub Pages site. After the page loads, it asks the database for the current
// status of the profiles on the page (public_maid_status(): code + status only, public "anon" key) and updates the
// status labels. Placed / unavailable / withdrawn profiles are hidden from listings and marked on their profile page.
// Search engines see the status from the last website build; visitors see the live one. If the database cannot be
// reached, the page simply keeps the built status — nothing breaks.
import { DB_ENABLED, DB_URL, dbHeaders } from '../lib/db';
import { DEMO, REVIEW } from '../lib/maids';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const T = t(Astro.props.lang);
const on = DB_ENABLED && !DEMO && !REVIEW;
const cfg = { url: `${DB_URL}/rest/v1/rpc/public_maid_status`, headers: dbHeaders(), labels: T.status, hidden: ['placed', 'unavailable', 'withdrawn'] };
---
{on && (
  <script is:inline type="module" define:vars={{ cfg }}>
    const pills = [...document.querySelectorAll('[data-live-status]')];
    if (pills.length) {
      try {
        const res = await fetch(cfg.url, { method: 'POST', headers: cfg.headers, body: '{}' });
        if (res.ok) {
          const live = new Map((await res.json()).map((r) => [r.code, r]));
          for (const pill of pills) {
            const r = live.get(pill.dataset.liveStatus);
            const gone = !r || cfg.hidden.includes(r.status); // unpublished or no longer available
            const shown = gone ? (r?.status ?? 'unavailable') : r.status_recorded ? r.status : 'unconfirmed';
            pill.textContent = cfg.labels[shown] ?? pill.textContent;
            pill.className = `status status--${shown}`;
            const card = pill.closest('[data-maid]');
            if (card) { card.dataset.status = shown; if (gone) { card.dataset.gone = '1'; card.hidden = true; } }
            else if (gone) document.querySelector('[data-live-gone]')?.removeAttribute('hidden');
          }
          document.dispatchEvent(new CustomEvent('maids:live-status'));
        }
      } catch { /* offline or database paused: keep the status from the last build */ }
    }
  </script>
)}

---
// Live availability for the static GitHub Pages site. After the page loads it asks the database for the CONFIRMED availability of the profiles on the page
// and updates the status labels, so a change saved by staff shows on the next page load without a website rebuild.
//
// Two modes (never both):
//  • HYBRID (PUBLIC_LIVE_STATUS=true, profiles stay in the GitHub files) → public_site_status(): code + confirmed status + verification time, matched by REFERENCE CODE.
//    SAFETY RULES: a failed request, a timeout, an empty or malformed answer, or a code with no row changes NOTHING — every published card stays visible with the label built into the page.
//    Only an explicit confirmed "Hired" or "Withdrawn" row marks a maid as no longer available.
//  • DATABASE source (PUBLIC_MAIDS_SOURCE=supabase) → public_maid_status() as before.
import { DB_SOURCE, LIVE_STATUS, DB_URL, dbHeaders } from '../lib/db';
import { DEMO, REVIEW } from '../lib/maids';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const lang = Astro.props.lang;
const T = t(lang);
const on = (DB_SOURCE || LIVE_STATUS) && !DEMO && !REVIEW;
const cfg = {
  url: `${DB_URL}/rest/v1/rpc/${DB_SOURCE ? 'public_maid_status' : 'public_site_status'}`, headers: dbHeaders(), labels: T.status, hidden: ['hired', 'placed', 'unavailable', 'withdrawn'],
  strict: LIVE_STATUS && !DB_SOURCE, recorded: T.profile.recorded('{d}'), locale: lang === 'ms' ? 'ms-MY' : 'en-MY',
};
---
{on && (
  <script is:inline type="module" define:vars={{ cfg }}>
    const pills = [...document.querySelectorAll('[data-live-status]')];
    if (pills.length) {
      try {
        const ctl = new AbortController(); const timer = setTimeout(() => ctl.abort(), 6000);
        const res = await fetch(cfg.url, { method: 'POST', headers: cfg.headers, body: '{}', signal: ctl.signal });
        clearTimeout(timer);
        if (!res.ok) throw new Error('status request failed');
        const rows = await res.json();
        if (!Array.isArray(rows)) throw new Error('unexpected answer');
        if (cfg.strict && rows.length === 0) throw new Error('empty answer'); // never read "no rows" as "everyone is gone"
        const live = new Map(rows.filter((r) => r && typeof r.code === 'string' && typeof r.status === 'string').map((r) => [r.code.toUpperCase(), r]));
        for (const pill of pills) {
          const r = live.get(String(pill.dataset.liveStatus).toUpperCase());
          if (cfg.strict && !r) continue;                       // no record for this code: keep the built card exactly as it is
          const gone = cfg.strict ? cfg.hidden.includes(r.status) : (!r || cfg.hidden.includes(r.status)); // unpublished or no longer available (database mode only for "missing")
          const raw = gone ? (r?.status ?? 'unavailable') : cfg.strict ? r.status : (r.status_recorded ? r.status : 'unconfirmed');
          const shown = raw === 'to-be-confirmed' ? 'unconfirmed' : raw;
          if (!(shown in cfg.labels)) continue;                 // a status this page does not know: leave it alone
          pill.textContent = cfg.labels[shown]; pill.className = `status status--${shown}`;
          const card = pill.closest('[data-maid]');
          if (card) { card.dataset.status = shown; if (gone) { card.dataset.gone = '1'; card.hidden = true; } }
          else {                                                 // the profile page itself
            const note = document.querySelector('[data-live-note]');
            if (note && shown !== 'unconfirmed' && !gone && r.verified_at) note.textContent = cfg.recorded.replace('{d}', new Date(r.verified_at).toLocaleDateString(cfg.locale, { day: 'numeric', month: 'short', year: 'numeric' }));
            if (note && shown === 'unconfirmed') note.hidden = false;
            if (gone) { document.querySelector('[data-live-gone]')?.removeAttribute('hidden'); if (note) note.hidden = true; document.querySelectorAll('[data-biodata-pdf]').forEach((b) => (b.hidden = true)); }
          }
        }
        document.dispatchEvent(new CustomEvent('maids:live-status'));
      } catch { /* offline, paused, slow, empty or malformed: keep every card and the status from the last build */ }
    }
  </script>
)}

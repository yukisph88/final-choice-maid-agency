---
import Icon from './Icon.astro';
import { site } from '../lib/config';
import { whatsappLink, telLink, WA } from '../lib/urls';
interface Props { title?: string; text?: string; message?: string }
const {
  title = 'Talk to a consultant about your household',
  text = 'Tell us what your family needs. We will recommend suitable helpers and explain the next steps, costs and documents.',
  message = WA.home,
} = Astro.props;
---
<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--wa btn--lg" href={whatsappLink(message)} target="_blank" rel="noopener" data-track="cta_band">
        <Icon name="whatsapp" size={20} /> WhatsApp {site.contact.consultantName}
      </a>
      <a class="btn btn--ghost-light btn--lg" href={telLink} data-track="cta_band_call">
        <Icon name="phone" size={18} /> Call {site.contact.phoneDisplay}
      </a>
    </div>
  </div>
</section>

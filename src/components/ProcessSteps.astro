---
import Icon from './Icon.astro';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
interface Props { lang: Lang; detailed?: boolean; headingLevel?: 'h2' | 'h3' }
const { lang, detailed = false, headingLevel = 'h3' } = Astro.props;
const P = t(lang).process;
const H = headingLevel;
const ICONS = ['chat', 'file', 'users', 'clipboard', 'shield', 'plane', 'handshake'];
---
<ol class={`process${detailed ? ' process--detailed' : ''}`}>
  {P.steps.map((s, i) => (
    <li class="process__step">
      <span class="process__num" aria-hidden="true">{i + 1}</span>
      <div class="process__body">
        <H class="process__title"><span class="sr-only">{P.step} {i + 1}: </span>{s.title}</H>
        <p>{s.text}</p>
        {detailed && <p class="muted">{s.more}</p>}
      </div>
      <span class="process__icon"><Icon name={ICONS[i]} size={22} /></span>
    </li>
  ))}
</ol>
<p class="process__note">
  <Icon name="clock" size={18} />
  {P.note}
</p>

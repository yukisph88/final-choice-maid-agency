---
// Package price cards. Every price, term and inclusion comes from ONE file (src/data/packages.yaml)
// for both languages, so the homepage, the Packages page and the nationality pages always show identical terms.
// Only lines marked "verified: true" are displayed. Each category keeps its own terms (no sharing between them).
import Icon from './Icon.astro';
import { packages, type Nationality } from '../lib/config';
import { whatsappLink } from '../lib/urls';
import type { Lang } from '../i18n/routes';
import { t, formatLongDate } from '../i18n/ui';
interface Props { lang: Lang; only?: Nationality; headingLevel?: 'h2' | 'h3'; id?: string }
const { lang, only, headingLevel = 'h3', id = 'packages-tabs' } = Astro.props;
const T = t(lang);
const ms = lang === 'ms';
const H = headingLevel;
const cats = packages.categories.filter((c) => !only || c.nationality === only).map((c) => ({
  ...c, name: ms ? c.label_ms : c.label, tab: ms ? c.tab_ms : c.tab,
  includes: c.includes.filter((x) => x.verified),
}));
const rm = (n: number) => `RM${n.toLocaleString('en-MY')}`;
const reviewed = formatLongDate(new Date(packages.lastReviewed + 'T00:00:00+08:00'), lang);
---
<div class="packages" data-tabs>
  {cats.length > 1 && (
    <div class={`tabs tabs--${cats.length}`} role="tablist" aria-label={T.pkg.chooseCategory}>
      {cats.map((c, i) => (
        <button class="tab" type="button" role="tab" id={`${id}-tab-${c.id}`} aria-controls={`${id}-panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <span class="tab__long">{c.name}</span><span class="tab__short">{c.tab}</span>
        </button>
      ))}
    </div>
  )}

  {cats.map((c, i) => (
    <div class="tab-panel" role={cats.length > 1 ? 'tabpanel' : undefined} id={`${id}-panel-${c.id}`} aria-labelledby={cats.length > 1 ? `${id}-tab-${c.id}` : undefined} hidden={i > 0 ? true : undefined}>
      {cats.length === 1 && <p class="package-category">{c.name}</p>}
      <div class={`package-grid package-grid--${c.packages.length}`}>
        {c.packages.map((p) => {
          const shown = p.terms.filter((x) => x.verified);
          return (
            <article class={`package-card${p.highlight ? ' package-card--highlight' : ''}`}>
              <p class="package-card__eyebrow">{c.name}</p>
              <H class="package-card__name">{p.name}</H>
              <p class="package-card__price">
                {p.price ? (<><span class="package-card__amount">{rm(p.price)}</span><span class="package-card__note">{T.pkg.referencePrice}</span></>) : <span class="package-card__amount package-card__amount--quote">{T.pkg.quote}</span>}
              </p>
              {shown.length > 0 ? (
                <ul class="ticks">
                  {shown.map((x) => <li><Icon name="check" size={18} />{ms ? x.text_ms : x.text}</li>)}
                </ul>
              ) : (
                <p class="package-card__pending">{T.pkg.pending}</p>
              )}
              <a class={`btn ${p.highlight ? 'btn--wa' : 'btn--wa-outline'} btn--block`} href={whatsappLink(T.wa.package(c.name, p.name, p.price ? rm(p.price) : ''))} target="_blank" rel="noopener" data-track={`package_${c.id}_${p.id}`}>
                <Icon name="whatsapp" size={18} /> {T.btn.enquirePackage} {p.name}
              </a>
            </article>
          );
        })}
      </div>
      {c.includes.length > 0 && (
        <div class="package-includes">
          <p class="package-includes__title">{T.pkg.allInclude(c.name)}</p>
          <ul class="ticks package-includes__list">
            {c.includes.map((x) => <li><Icon name="check" size={18} />{ms ? x.text_ms : x.text}</li>)}
          </ul>
        </div>
      )}
    </div>
  ))}
  <p class="package-footnote">* {ms ? packages.priceNote_ms : packages.priceNote} <span class="muted">{T.pkg.reviewed} {reviewed}.</span></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((x) => {
        const on = x === tab;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(x.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const n = tabs[(i + d + tabs.length) % tabs.length];
        select(n); n.focus();
      });
    });
  });
</script>

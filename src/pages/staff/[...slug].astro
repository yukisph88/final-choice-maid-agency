---
// PRIVATE staff portal (Supabase). Not linked from the website, not in the sitemap, noindex.
// Security does not depend on this page being hidden: every read and write is checked by the database
// (Row Level Security) against the signed-in staff member's role. Without a staff account nothing loads.
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/montserrat/700.css';
import { DB_URL, DB_KEY, DB_ENABLED } from '../../lib/db';
import { href, asset } from '../../lib/urls';
// The portal page is only BUILT when a Supabase project is configured (PUBLIC_SUPABASE_URL + key at build time).
export function getStaticPaths() {
  // never in the private review build (it is shared with management on other computers)
  return DB_ENABLED && import.meta.env.PUBLIC_REVIEW_MODE !== 'true' ? [{ params: { slug: undefined } }] : [];
}
---
<!doctype html>
<html lang="en-MY">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>Final Choice staff portal</title>
  <meta name="description" content="Private Final Choice staff portal. Authorised staff only." />
  <link rel="canonical" href={new URL(href('staff/'), Astro.site).href} />
  <link rel="icon" href={asset('favicon/favicon-48.png')} />
  <style is:global>
    :root { --ink:#141c2e; --muted:#566379; --line:#dde5f0; --bg:#f3f6fb; --navy:#1f3a93; --navy-d:#172c70; --blue:#2563eb; --green:#0e7a40; --amber:#a15c00; --red:#b42318; --r:12px; --side:252px; }
    * { box-sizing: border-box; }
    body { margin: 0; font: 15px/1.5 'IBM Plex Sans', system-ui, Segoe UI, Arial, sans-serif; color: var(--ink); background: var(--bg); }
    h1, h2, h3, h4 { font-family: Montserrat, 'IBM Plex Sans', sans-serif; margin: 0; }
    button, input, select, textarea { font: inherit; }
    a { color: var(--navy); }
    [hidden] { display: none !important; }
    .strong { font-weight: 600; } .nw { white-space: nowrap; } .grow { flex: 1; min-width: 180px; }
    .hint { color: var(--muted); font-size: .84rem; font-weight: 400; margin: 2px 0 0; }
    .pad { padding: 18px; } .empty { padding: 28px; text-align: center; color: var(--muted); }
    /* buttons */
    .btn { border: 1px solid var(--navy); background: var(--navy); color: #fff; border-radius: 8px; padding: 8px 14px; font-weight: 600; cursor: pointer; white-space: nowrap; text-decoration: none; display: inline-block; line-height: 1.3; }
    .btn:hover { background: var(--navy-d); } .btn--ghost { background: #fff; color: var(--navy); } .btn--ghost:hover { background: #eef3ff; }
    .btn--danger { background: #fff; color: var(--red); border-color: var(--red); } .btn--danger:hover { background: #fdecea; }
    .btn--danger-solid { background: var(--red); border-color: var(--red); } .btn--danger-solid:hover { background: #8f1c12; }
    .btn--sm { padding: 4px 10px; font-size: .86rem; } .btn:disabled { opacity: .5; cursor: not-allowed; }
    :focus-visible { outline: 3px solid #93b4ff; outline-offset: 1px; }
    .card { background: #fff; border: 1px solid var(--line); border-radius: var(--r); }
    /* sign-in cards */
    .center { max-width: 420px; margin: 8vh auto; padding: 28px; }
    .center h2 { font-size: 1.3rem; margin-bottom: 6px; }
    label { display: block; font-weight: 600; font-size: .88rem; margin: 12px 0 4px; }
    .fld label { margin-top: 0; } .fld { margin: 0 0 12px; }
    input[type=text], input[type=email], input[type=password], input[type=number], input[type=date], input[type=search], input:not([type]), select, textarea { width: 100%; padding: 8px 10px; border: 1px solid #b9c4d6; border-radius: 8px; background: #fff; color: var(--ink); }
    textarea { min-height: 80px; resize: vertical; } input:disabled, select:disabled, textarea:disabled { background: #f1f3f7; color: #555; }
    .check { display: flex; gap: 8px; align-items: flex-start; font-weight: 500; margin: 8px 0; } .check input { margin-top: 4px; }
    td select, .bulk select { width: auto; padding: 4px 8px; }
    /* layout */
    .app { display: grid; grid-template-columns: var(--side) 1fr; min-height: 100vh; }
    .side { background: linear-gradient(180deg, var(--navy) 0%, var(--navy-d) 100%); color: #fff; position: sticky; top: 0; height: 100vh; overflow-y: auto; display: flex; flex-direction: column; }
    .brand { display: flex; align-items: center; gap: 10px; padding: 16px 16px 12px; }
    .brand img { height: 34px; background: #fff; border-radius: 8px; padding: 3px; } .brand b { font: 700 .95rem Montserrat, sans-serif; line-height: 1.15; } .brand small { display: block; font-weight: 400; opacity: .75; font-size: .74rem; }
    #nav { padding: 6px 10px 20px; display: grid; gap: 2px; }
    .nav-a { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 9px; color: #dfe7ff; text-decoration: none; font-weight: 500; }
    .nav-a:hover { background: rgba(255,255,255,.1); } .nav-on, .nav-on:hover { background: #fff; color: var(--navy); font-weight: 600; }
    .nav-i { width: 22px; text-align: center; opacity: .9; }
    .main { min-width: 0; }
    .top { position: sticky; top: 0; z-index: 20; background: #fff; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 12px; padding: 10px 20px; min-height: 64px; }
    #page-title { font-size: 1.15rem; flex: 1; min-width: 0; } #page-title small { display: block; font: 400 .8rem 'IBM Plex Sans', sans-serif; color: var(--muted); }
    #burger { display: none; } .scrim { position: fixed; inset: 0; background: rgba(20,28,46,.45); z-index: 29; }
    .me { position: relative; } .me-btn { display: flex; align-items: center; gap: 10px; border: 1px solid var(--line); background: #fff; border-radius: 99px; padding: 4px 12px 4px 4px; cursor: pointer; }
    .me-av { width: 34px; height: 34px; border-radius: 50%; background: var(--navy); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: .85rem; }
    .me-t { text-align: left; line-height: 1.15; } .me-t b { display: block; font-size: .88rem; } .me-t small { color: var(--muted); font-size: .74rem; }
    .menu { position: absolute; right: 0; top: calc(100% + 8px); width: 250px; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 12px 36px rgba(0,0,0,.18); padding: 8px; z-index: 40; }
    .menu-h { padding: 8px 10px 10px; border-bottom: 1px solid var(--line); margin-bottom: 6px; } .menu-h b { display: block; } .menu-h span { color: var(--muted); font-size: .82rem; display: block; word-break: break-all; }
    .menu a, .menu button { display: block; width: 100%; text-align: left; padding: 8px 10px; border: 0; background: none; border-radius: 8px; color: var(--ink); text-decoration: none; cursor: pointer; }
    .menu a:hover, .menu button:hover { background: #eef3ff; }
    #view { padding: 20px; max-width: 1320px; }
    @media (max-width: 900px) {
      .app { grid-template-columns: 1fr; } .side { position: fixed; left: 0; top: 0; bottom: 0; width: 270px; z-index: 30; transform: translateX(-102%); transition: transform .2s; } .side.open { transform: none; }
      #burger { display: inline-block; } .me-t { display: none; } .me-btn { padding: 4px; } .top { padding: 8px 12px; } #view { padding: 14px 12px; }
    }
    /* toolbars, tables */
    .toolbar2 { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; margin: 0 0 10px; } .toolbar2 .fld { margin: 0; min-width: 150px; }
    .actions-bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 8px 0 10px; } .count { color: var(--muted); font-size: .88rem; margin-left: auto; }
    .bulk { background: #eef3ff; border: 1px solid #cfdcf7; border-radius: 10px; padding: 8px 12px; }
    .tbl-wrap { overflow-x: auto; } .tbl { width: 100%; border-collapse: collapse; font-size: .9rem; }
    .tbl th { text-align: left; padding: 9px 10px; background: #f7f9fd; border-bottom: 1px solid var(--line); font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; color: var(--muted); white-space: nowrap; }
    .tbl td { padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: middle; } .tbl--click tr[data-act] { cursor: pointer; } .tbl--click tr[data-act]:hover td { background: #f5f8ff; }
    .tbl-wrap .tbl:only-child tr:last-child td { border-bottom: 0; } .yes { color: var(--green); font-weight: 700; } .no { color: #9aa5b8; }
    .thumb { width: 44px; height: 55px; object-fit: cover; border-radius: 8px; background: #eef1f6; display: grid; place-items: center; color: var(--muted); font-weight: 700; font-size: .8rem; flex: none; }
    .thumb--sm { width: 36px; height: 45px; } .thumb--lg { width: 64px; height: 80px; } .thumb--none { background: #e8edf6; }
    .mini { display: flex; gap: 10px; align-items: center; } .mini--row { text-decoration: none; color: inherit; padding: 6px 0; } .mini--row:hover { background: #f5f8ff; }
    .pager { display: flex; gap: 4px; flex-wrap: wrap; justify-content: center; margin: 14px 0; } .pg { border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: 5px 11px; cursor: pointer; } .pg--cur { background: var(--navy); color: #fff; border-color: var(--navy); } .pg:disabled { opacity: .4; cursor: default; }
    .pill { display: inline-block; border-radius: 99px; padding: 2px 10px; font-size: .78rem; font-weight: 700; background: #eef1f6; color: #4a5468; white-space: nowrap; }
    .pill--ok { background: #e8f6ee; color: var(--green); } .pill--warn { background: #fff4e0; color: var(--amber); } .pill--blue { background: #e6efff; color: var(--navy); } .pill--violet { background: #efeafc; color: #5b3fb0; }
    .pill--dark { background: #2a3550; color: #fff; } .pill--tbc { background: #fdf0d5; color: #8a5300; border: 1px dashed #d9a441; } .pill--red { background: #fdecea; color: var(--red); } .pill--grey { background: #eef1f6; color: #4a5468; }
    .note { background: #fff8e6; border: 1px solid #f3dfa8; border-radius: 10px; padding: 10px 12px; margin: 0 0 14px; font-size: .9rem; }
    .err { background: #fdecea; border: 1px solid #f5c2bd; color: var(--red); border-radius: 10px; padding: 10px 12px; margin: 10px 0; white-space: pre-line; }
    .ok { background: #e8f6ee; border: 1px solid #b6e2c6; color: var(--green); border-radius: 10px; padding: 10px 12px; margin: 10px 0; }
    .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; } .g3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 16px; } .g2i { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    @media (max-width: 760px) { .g2, .g3, .g2i { grid-template-columns: 1fr; } }
    .sec { font-size: 1rem; margin: 18px 0 8px; } .card > .sec:first-child, .pad > .sec:first-child { margin-top: 0; } ul.plain { padding-left: 18px; } ul.plain li { margin: 6px 0; }
    /* dashboard */
    .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 16px; } .kpis--sm { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }
    .kpi { background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 14px; text-decoration: none; color: var(--ink); text-align: left; display: block; }
    .kpi b { display: block; font: 700 1.7rem Montserrat, sans-serif; color: var(--navy); } .kpi span { color: var(--muted); font-size: .84rem; } button.kpi { cursor: pointer; font: inherit; } .kpi--btn:hover { border-color: var(--navy); background: #f5f8ff; }
    .dash2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; margin-bottom: 16px; } .dash2 h4 { font-size: .9rem; margin: 4px 0; }
    .bars { display: grid; gap: 6px; } .barrow { display: grid; grid-template-columns: 130px 1fr 34px; gap: 8px; align-items: center; text-decoration: none; color: var(--ink); font-size: .88rem; } .barrow i { display: block; height: 10px; border-radius: 6px; background: var(--blue); } .barrow b { text-align: right; }
    .act { display: grid; gap: 0; padding: 6px 0; border-bottom: 1px solid var(--line); font-size: .88rem; } .quick { display: flex; gap: 8px; flex-wrap: wrap; }
    .prog { height: 6px; background: #e8edf6; border-radius: 4px; margin-top: 4px; min-width: 80px; } .prog i { display: block; height: 100%; background: var(--green); border-radius: 4px; }
    /* photos */
    .pgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; margin: 10px 0; } .pcard { background: #fff; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; }
    .pimg { aspect-ratio: 4 / 5; background: #eef1f6; display: grid; place-items: center; } .pimg img { width: 100%; height: 100%; object-fit: cover; cursor: zoom-in; } .pmeta { padding: 10px; }
    .photo-box { display: flex; gap: 18px; flex-wrap: wrap; } .photo-frame { width: 220px; aspect-ratio: 4 / 5; border-radius: 12px; overflow: hidden; background: #eef1f6; display: grid; place-items: center; } .photo-frame img { width: 100%; height: 100%; object-fit: cover; }
    .photo-empty { color: var(--muted); padding: 14px; text-align: center; } .photo-side { flex: 1; min-width: 240px; } .row-actions { display: flex; gap: 8px; flex-wrap: wrap; margin: 8px 0; }
    .crop { display: flex; justify-content: center; margin: 8px 0; } .crop canvas { border: 1px solid var(--line); border-radius: 8px; touch-action: none; cursor: grab; max-width: 100%; background: #eee; }
    /* editor */
    .bar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: space-between; background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 12px 16px; margin-bottom: 12px; position: sticky; top: 64px; z-index: 10; }
    .bar-l { display: flex; gap: 14px; align-items: center; } .bar-name { font: 700 1.1rem Montserrat, sans-serif; } .bar-sub { color: var(--muted); font-size: .88rem; } .bar-r { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .dirty { background: #fff4e0; color: var(--amber); padding: 3px 10px; border-radius: 99px; font-size: .8rem; font-weight: 700; }
    .tabs2 { display: flex; gap: 2px; flex-wrap: wrap; border-bottom: 1px solid var(--line); margin-bottom: 0; } .tabs2 button { border: 0; background: none; padding: 9px 13px; border-radius: 9px 9px 0 0; font-weight: 600; color: var(--muted); cursor: pointer; }
    .tabs2 button[aria-selected=true] { color: var(--navy); background: #fff; border: 1px solid var(--line); border-bottom-color: #fff; margin-bottom: -1px; }
    .tabs2 + .card { border-top-left-radius: 0; } .rowline { display: grid; grid-template-columns: 1fr 180px auto; gap: 8px; margin-bottom: 8px; } .job { border: 1px solid var(--line); border-radius: 10px; padding: 10px; margin-bottom: 10px; display: grid; gap: 8px; } .job-g { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    @media (max-width: 640px) { .rowline, .job-g { grid-template-columns: 1fr; } .bar { position: static; } }
    .verif { padding: 8px 0; } .pwbox { font: 700 1.3rem ui-monospace, Consolas, monospace; background: #f1f4fa; border-radius: 10px; padding: 14px; text-align: center; letter-spacing: .04em; user-select: all; }
    /* dialogs */
    dialog.dlg { border: 0; border-radius: 16px; padding: 0; width: min(560px, 96vw); max-height: 92vh; box-shadow: 0 20px 60px rgba(0,0,0,.28); color: var(--ink); } dialog.dlg--wide { width: min(960px, 96vw); } dialog::backdrop { background: rgba(20,28,46,.5); }
    .dlg-head { display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: #fff; z-index: 2; } .dlg-head h2 { font-size: 1.1rem; flex: 1; }
    .dlg-body { padding: 8px 20px 18px; overflow: auto; max-height: calc(92vh - 130px); } .dlg-foot { display: flex; gap: 8px; justify-content: flex-end; padding: 12px 20px; border-top: 1px solid var(--line); position: sticky; bottom: 0; background: #fff; flex-wrap: wrap; align-items: center; }
    .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; margin: 8px 0; } .seg-b { border: 0; background: #fff; padding: 6px 14px; cursor: pointer; font-weight: 600; } .seg-b.on { background: var(--navy); color: #fff; }
    .pv { border: 1px solid var(--line); border-radius: 12px; padding: 12px; position: relative; } .pv--draft { background: repeating-linear-gradient(135deg, #fff, #fff 12px, #fafbfd 12px, #fafbfd 24px); } .pv-ribbon { background: #fff4e0; color: var(--amber); font-weight: 700; font-size: .8rem; padding: 4px 10px; border-radius: 8px; display: inline-block; margin-bottom: 8px; }
    .pv-card { display: grid; grid-template-columns: 150px 1fr; gap: 14px; } .pv-photo { aspect-ratio: 4 / 5; border-radius: 10px; overflow: hidden; background: #eef1f6; display: grid; place-items: center; } .pv-photo img { width: 100%; height: 100%; object-fit: cover; } .pv-nophoto { color: var(--muted); font-size: .8rem; text-align: center; padding: 8px; }
    .pv-top { display: flex; justify-content: space-between; gap: 8px; } .pv-nat { color: var(--muted); font-size: .85rem; } .pv h3 { margin: 6px 0 0; } .pv-ref { margin: 0; color: var(--muted); } .pv dl { margin: 8px 0; } .pv dt { color: var(--muted); font-size: .78rem; } .pv dd { margin: 0 0 4px; }
    .pv-chips { display: flex; flex-wrap: wrap; gap: 6px; } .pv-chips span { background: #eef3ff; color: var(--navy); border-radius: 99px; padding: 2px 10px; font-size: .8rem; font-weight: 600; } .pv-profile h4 { margin: 12px 0 4px; font-size: .9rem; }
    @media (max-width: 560px) { .pv-card { grid-template-columns: 1fr; } }
    .toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: var(--ink); color: #fff; padding: 10px 18px; border-radius: 10px; z-index: 100; max-width: 92vw; } .toast--err { background: var(--red); }
    @media (max-width: 640px) { .tbl--maids th:nth-child(3), .tbl--maids td:nth-child(3), .tbl--maids th:nth-child(4), .tbl--maids td:nth-child(4), .tbl--maids th:nth-child(7), .tbl--maids td:nth-child(7) { display: none; } .tbl td { padding: 8px 6px; } .toolbar2 .fld { min-width: 120px; flex: 1; } .actions-bar .count { margin-left: 0; } }
    @media print { .side, .top, .toolbar2, .actions-bar, .toast, #burger { display: none !important; } .app { display: block; } #view { padding: 0; } .card { border: 0; } }
  </style>
</head>
<body>
  <div id="cfg" data-url={DB_URL} data-key={DB_KEY} hidden></div>

  <section id="v-noconfig" class="card center" hidden={DB_ENABLED}>
    <h2>Database not connected</h2>
    <p class="hint">This build has no Supabase project configured. See supabase/README.md.</p>
  </section>

  <section id="v-login" class="card center" hidden>
    <img src={asset('images/logo-final-choice.png')} alt="Final Choice" style="height:44px" />
    <h2 style="margin-top:14px">Staff sign in</h2>
    <p class="hint">Final Choice staff portal — authorised staff only.</p>
    <form id="f-login">
      <label for="l-email">E-mail</label><input id="l-email" type="email" autocomplete="username" required />
      <label for="l-pass">Password</label><input id="l-pass" type="password" autocomplete="current-password" required />
      <div id="l-msg"></div>
      <button class="btn" type="submit" style="margin-top:16px;width:100%">Sign in</button>
    </form>
    <p class="hint" style="margin-top:14px"><a href="#" id="l-forgot">Forgot password?</a> Enter your e-mail above first.</p>
  </section>

  <section id="v-pass" class="card center" hidden>
    <img src={asset('images/logo-final-choice.png')} alt="Final Choice" style="height:44px" />
    <h2 style="margin-top:14px">Set a new password</h2>
    <p class="hint">At least 12 characters. Use a password you do not use anywhere else.</p>
    <form id="f-pass">
      <label for="p-new">New password</label><input id="p-new" type="password" autocomplete="new-password" minlength="12" required />
      <label for="p-new2">Repeat the new password</label><input id="p-new2" type="password" autocomplete="new-password" minlength="12" required />
      <div id="p-msg"></div>
      <button class="btn" type="submit" style="margin-top:16px;width:100%">Save password</button>
      <button class="btn btn--ghost" type="button" id="p-cancel" style="margin-top:8px;width:100%" hidden>Cancel</button>
    </form>
  </section>

  <section id="v-denied" class="card center" hidden>
    <h2>No access</h2>
    <p class="hint">You are signed in, but this account is not an active Final Choice staff account. Ask the administrator to add you.</p>
    <button class="btn btn--ghost" data-signout type="button" style="margin-top:12px">Sign out</button>
  </section>

  <div id="v-app" class="app" hidden>
    <aside class="side" id="side" aria-label="Main navigation">
      <div class="brand"><img src={asset('images/logo-final-choice-mark.png')} alt="" /><b>Final Choice<small>Staff portal</small></b></div>
      <nav id="nav"></nav>
    </aside>
    <div class="scrim" id="scrim" hidden></div>
    <div class="main">
      <header class="top">
        <button class="btn btn--ghost btn--sm" id="burger" type="button" aria-label="Open menu">☰ Menu</button>
        <h1 id="page-title">Dashboard</h1>
        <div class="me">
          <button class="me-btn" id="me-btn" type="button" aria-haspopup="true" aria-expanded="false"><span class="me-av" id="me-av">?</span><span class="me-t"><b id="me-name"></b><small id="me-role"></small></span></button>
          <div class="menu" id="menu" hidden>
            <div class="menu-h"><b id="menu-name"></b><span id="menu-mail"></span><span id="menu-role"></span></div>
            <a href="#/settings" id="menu-settings">My settings</a>
            <button type="button" id="menu-pass">Change password</button>
            <button type="button" data-signout>Sign out</button>
          </div>
        </div>
      </header>
      <main id="view"></main>
    </div>
  </div>

  <div class="toast" id="toast" hidden></div>
  <script>
    import './../../staff/portal/portal.ts';
  </script>
</body>
</html>

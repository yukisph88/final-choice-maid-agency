---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PackageCards from '../components/PackageCards.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/urls';
---
<BaseLayout
  title="Maid Packages Malaysia | Premium, Platinum, Diamond | Final Choice"
  description="Compare Final Choice Premium, Platinum and Diamond maid packages for Indonesian and Filipino helpers, with reference prices and a WhatsApp quotation."
  path="/maid-packages/"
  crumbs={[{ name: 'Maid Packages', path: '/maid-packages/' }]}
>
  <PageHero
    eyebrow="Maid packages"
    title="Maid packages and reference prices"
    lead="Three package levels for Indonesian and Filipino domestic helpers. Terms are set separately for each nationality — select one to compare, then request a confirmed quotation."
  />
  <section class="section">
    <div class="container">
      <PackageCards id="pkg-page" headingLevel="h2" />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container split" style="align-items:start">
      <div class="prose">
        <h2>Before you choose a package</h2>
        <ul>
          <li>Your consultant confirms the final price, inclusions and terms in writing before you commit.</li>
          <li>Warranty and replacement arrangements apply according to your service agreement.</li>
          <li>Government fees, levies, insurance and other statutory costs may apply. Ask us which are included in your quotation.</li>
          <li>Package terms for Indonesian and Filipino helpers are different. Do not assume one applies to the other.</li>
        </ul>
      </div>
      <div class="prose">
        <h2>What a quotation covers</h2>
        <p>
          When you WhatsApp us about a package, tell us your preferred nationality and your household’s needs. We will send a
          quotation that lists what is included, what is not, and the payment schedule, so you can compare clearly.
        </p>
        <p><a href={href('/maid-hiring-process/')}>See the hiring process</a> · <a href={href('/faq/')}>Read the FAQ</a></p>
      </div>
    </div>
  </section>
  <CtaBand title="Get an accurate quotation" text="WhatsApp our consultant with your preferred package and nationality." />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/urls';
---
<BaseLayout title="Page not found | Final Choice" description="The page you were looking for could not be found. Browse maid biodata or contact Final Choice." path="/404/" noindex>
  <section class="section">
    <div class="container empty-state" style="border:0">
      <p class="eyebrow">Error 404</p>
      <h1>Page not found</h1>
      <p>The page may have moved, or a profile may no longer be available.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href={href('/')}>Go to homepage</a>
        <a class="btn btn--outline" href={href('/maids/')}>Browse maid biodata <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/config';
import { whatsappLink, telLink, WA } from '../lib/urls';
import { organizationSchema } from '../lib/schema';
const c = site.company;
---
<BaseLayout
  title="Contact Final Choice | Maid Agency in Kuala Lumpur"
  description="Contact Agensi Pekerjaan Final Choice in Taman Mutiara Barat, Kuala Lumpur. WhatsApp our consultant, call, email or send an enquiry about hiring a domestic helper."
  path="/contact/"
  crumbs={[{ name: 'Contact', path: '/contact/' }]}
  schema={[organizationSchema()]}
>
  <PageHero eyebrow="Contact" title="Contact Final Choice" lead="WhatsApp is the quickest way to reach our consultant. You are also welcome to call, email or visit our office during office hours." />
  <section class="section">
    <div class="container contact-grid">
      <div class="info-panel">
        <h2>Our office</h2>
        <ul class="contact-list">
          <li><Icon name="whatsapp" size={20} /><span><strong>WhatsApp</strong><br /><a href={whatsappLink(WA.home)} target="_blank" rel="noopener" data-track="contact_page_wa">{site.contact.consultantName} — {site.contact.phoneDisplay}</a></span></li>
          <li><Icon name="phone" size={20} /><span><strong>Phone</strong><br /><a href={telLink} data-track="contact_page_phone">{site.contact.phoneDisplay}</a></span></li>
          <li><Icon name="mail" size={20} /><span><strong>Email</strong><br /><a href={`mailto:${c.email}`}>{c.email}</a></span></li>
          <li><Icon name="pin" size={20} /><span><strong>Address</strong><br />{c.address.street},<br />{c.address.postcode} {c.address.city}, Malaysia<br /><a href={c.mapsUrl} target="_blank" rel="noopener">Open in Google Maps</a></span></li>
          <li><Icon name="clock" size={20} /><span><strong>Office hours</strong><br />{c.hours.map((h) => <>{h.label}: {h.opens}–{h.closes}<br /></>)}</span></li>
        </ul>
        <div class="licence-box">
          <span><strong>{c.legalName}</strong></span>
          <span>Company No. {c.registrationNo}</span>
          <span>Licence {c.licence}</span>
        </div>
      </div>
      <div>
        <h2>Send an enquiry</h2>
        <EnquiryForm idPrefix="contact" />
      </div>
    </div>
  </section>
</BaseLayout>

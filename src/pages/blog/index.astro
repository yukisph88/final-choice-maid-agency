---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { href } from '../../lib/urls';
import { formatDate } from '../../lib/maids';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.published - +a.data.published);
---
<BaseLayout
  title="Employer Guides | Hiring a Maid in Malaysia | Final Choice Blog"
  description="Practical guides for Malaysian employers on hiring a domestic helper: the hiring steps, documents, interviews, elderly care, and settling in after arrival."
  path="/blog/"
  crumbs={[{ name: 'Blog', path: '/blog/' }]}
>
  <PageHero eyebrow="Employer guides" title="Guides to hiring a domestic helper in Malaysia" lead="Practical, plain-language articles from our consultants to help you prepare, choose well and settle in." />
  <section class="section section--tight">
    <div class="container grid grid--3">
      {posts.map((p) => (
        <article class="card card--link post-card">
          <p class="muted" style="font-size:.85rem;margin-bottom:8px"><time datetime={p.data.published.toISOString()}>{formatDate(p.data.published)}</time></p>
          <h2><a class="stretched" href={href(`/blog/${p.id}/`)} style="color:inherit;text-decoration:none">{p.data.h1 ?? p.data.title}</a></h2>
          <p>{p.data.description}</p>
          <span class="card__more">Read guide <Icon name="arrow" size={16} /></span>
        </article>
      ))}
    </div>
  </section>
  <CtaBand />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { href, whatsappLink, WA } from '../../lib/urls';

const recruitment = [
  { icon: 'globe', title: 'Indonesian maid recruitment', text: 'Selection, interview and placement of Indonesian domestic helpers under current Malaysia–Indonesia procedures.', path: '/maids/indonesian-maids/' },
  { icon: 'globe', title: 'Filipino maid recruitment', text: 'Selection, interview and placement of Filipino domestic helpers, with guidance on Philippine documentation.', path: '/maids/filipino-maids/' },
  { icon: 'baby', title: 'Childcare helpers', text: 'Helpers experienced with babies, toddlers and school-going children.', path: '/services/childcare-maid/' },
  { icon: 'elderly', title: 'Elderly care helpers', text: 'Daily support and companionship for elderly family members at home.', path: '/services/elderly-care-maid/' },
  { icon: 'sparkle', title: 'Housekeeping helpers', text: 'Cleaning, laundry, ironing and cooking for a well-kept home.', path: '/services/housekeeping-maid/' },
  { icon: 'home', title: 'Domestic helper placement', text: 'End-to-end placement: matching, documentation, approvals follow-up, arrival and handover.', path: '/maid-hiring-process/' },
];
---
<BaseLayout
  title="Maid Services Malaysia | Recruitment & Renewal | Final Choice"
  description="Maid recruitment and placement, maid permit and contract renewal, replacement assistance and documentation guidance for Malaysian employers."
  path="/services/"
  crumbs={[{ name: 'Services', path: '/services/' }]}
>
  <PageHero
    eyebrow="Our services"
    title="Maid services for Malaysian employers"
    lead="From finding the right domestic helper to renewing her permit years later, Final Choice supports employers through each stage of employing a helper."
  />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Recruitment and placement</h2>
        <p>Find and place a domestic helper whose experience matches your household.</p>
      </div>
      <div class="grid grid--3">
        {recruitment.map((s) => (
          <div class="card card--link">
            <span class="card__icon"><Icon name={s.icon} size={24} /></span>
            <h3><a class="stretched" href={href(s.path)} style="color:inherit;text-decoration:none">{s.title}</a></h3>
            <p class="muted">{s.text}</p>
            <span class="card__more">Learn more <Icon name="arrow" size={16} /></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <h2>After placement</h2>
        <p>Support that continues after your helper has joined your family.</p>
      </div>
      <div class="grid grid--2">
        <article class="card" id="permit-renewal">
          <span class="card__icon"><Icon name="refresh" size={24} /></span>
          <h3>Maid work permit renewal</h3>
          <p class="muted">
            Your helper’s work pass must be renewed before it expires. We guide you on the documents and timing, and help you
            prepare the renewal. Please contact us well before the expiry date so there is enough time to complete it.
          </p>
          <a class="btn btn--wa-outline btn--sm" href={whatsappLink(WA.renewal)} target="_blank" rel="noopener" data-track="svc_renewal"><Icon name="whatsapp" size={16} /> Ask about renewal</a>
        </article>
        <article class="card" id="contract-renewal">
          <span class="card__icon"><Icon name="file" size={24} /></span>
          <h3>Maid contract renewal</h3>
          <p class="muted">
            When the employment contract ends, you may wish to continue with the same helper. We explain the renewal steps and
            the terms that apply, including any changes to salary or conditions required for her nationality.
          </p>
          <a class="btn btn--wa-outline btn--sm" href={whatsappLink(WA.renewal)} target="_blank" rel="noopener" data-track="svc_contract"><Icon name="whatsapp" size={16} /> Ask about contract renewal</a>
        </article>
        <article class="card" id="replacement">
          <span class="card__icon"><Icon name="swap" size={24} /></span>
          <h3>Maid replacement assistance</h3>
          <p class="muted">
            If a placement does not work out, we discuss the options with you. Replacement assistance, warranty period and any
            replacement fee depend on your package and the terms of your service agreement. See <a href={href('/maid-packages/')}>maid packages</a>.
          </p>
        </article>
        <article class="card" id="documentation">
          <span class="card__icon"><Icon name="clipboard" size={24} /></span>
          <h3>Employer documentation guidance</h3>
          <p class="muted">
            Clear guidance on the documents employers usually need to prepare — for new applications, renewals and changes —
            so that applications are complete the first time. Read <a href={href('/blog/documents-needed-to-hire-a-domestic-helper/')}>documents needed to hire a domestic helper</a>.
          </p>
        </article>
      </div>
      <div class="callout" style="margin-top:28px">
        <Icon name="shield" size={20} />
        <p>Final Choice provides guidance and assistance. Approvals and processing times are decided by the relevant authorities and cannot be guaranteed by any agency.</p>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>

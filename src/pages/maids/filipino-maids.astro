---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MaidDirectory from '../../components/MaidDirectory.astro';
import PackageCards from '../../components/PackageCards.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { href, whatsappLink, WA } from '../../lib/urls';
import { getPublicMaids, DEMO } from '../../lib/maids';
import { serviceSchema } from '../../lib/schema';

const maids = (await getPublicMaids()).filter((m) => m.nationality === 'filipino');
const desc = 'Hire a Filipino maid in Malaysia with Final Choice. Browse Filipino domestic helper biodata, interview candidates and get guidance on Philippine documentation.';
---
<BaseLayout
  title="Filipino Maid Agency Malaysia | Hire a Filipino Maid | Final Choice"
  description={desc}
  path="/maids/filipino-maids/"
  crumbs={[{ name: 'Find a Maid', path: '/maids/' }, { name: 'Filipino Maids', path: '/maids/filipino-maids/' }]}
  waMessage={WA.filipino}
  noindex={DEMO}
  schema={[serviceSchema({ name: 'Filipino domestic helper recruitment', description: desc, path: '/maids/filipino-maids/' })]}
>
  <PageHero
    eyebrow="Agensi pembantu rumah Filipina"
    title="Hire a Filipino maid in Malaysia"
    lead="Filipino domestic helpers are valued by many Malaysian families for their English communication and caregiving experience. We help you choose, interview and place the right helper."
  >
    <div class="btn-row">
      <a class="btn btn--wa btn--lg" href={whatsappLink(WA.filipino)} target="_blank" rel="noopener" data-track="ph_hero"><Icon name="whatsapp" size={20} /> Enquire about a Filipino maid</a>
      <a class="btn btn--outline btn--lg" href="#profiles">See profiles</a>
    </div>
  </PageHero>

  <section class="section section--tight" id="profiles" aria-labelledby="p-h">
    <div class="container">
      <h2 id="p-h">Filipino domestic helper profiles</h2>
      <MaidDirectory maids={maids} nationality="filipino" waMessage={WA.filipino} />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container split" style="align-items:start">
      <div class="prose">
        <h2>Why families choose Filipino helpers</h2>
        <p>
          English is widely spoken in the Philippines, so many Filipino helpers communicate comfortably in English.
          This can be helpful for families who speak English at home, for children’s routines and homework, and for
          following written care instructions for an elderly family member.
        </p>
        <p>
          Many candidates have worked as domestic helpers or caregivers in other countries before. Experience varies
          from person to person, so we look closely at each candidate’s actual duties — for example, whether she has
          cared for infants, assisted an elderly person with mobility, or cooked daily family meals.
        </p>
        <h3>What to discuss with us</h3>
        <p>
          Tell us the ages of your children or the care needs of elderly family members, the size of your home, and
          whether you have pets. We will also explain the salary and rest-day arrangements that apply to Filipino helpers.
        </p>
      </div>
      <div class="prose">
        <h2>How Filipino maid recruitment works</h2>
        <p>
          Filipino domestic workers are deployed under Philippine government rules in addition to Malaysian
          requirements. These typically include an employment contract verified by the Philippine authorities in Malaysia
          and the helper’s own pre-departure documentation in the Philippines. Requirements are updated from time to time,
          so we confirm the current checklist with you at the start.
        </p>
        <ol>
          <li>Share your requirements and review suitable biodata</li>
          <li>Interview your shortlisted candidate</li>
          <li>Prepare your documents and the employment contract</li>
          <li>Contract verification and approvals</li>
          <li>Helper’s departure processing, travel and arrival</li>
          <li>FOMEMA medical examination, orientation and handover</li>
        </ol>
        <p><a href={href('/maid-hiring-process/')}>See the full hiring process</a> · <a href={href('/blog/indonesian-maid-vs-filipino-maid/')}>Indonesian vs Filipino maid</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pk-h">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 id="pk-h">Filipino maid packages</h2>
        <p>Compare Premium, Platinum and Diamond for Filipino helpers. Inclusions are confirmed by our consultant with your quotation.</p>
      </div>
      <PackageCards only="filipino" id="ph-packages" />
    </div>
  </section>

  <section class="section section--tint section--tight">
    <div class="container">
      <h2 style="font-size:1.4rem">Related pages</h2>
      <ul class="related-links">
        <li><a href={href('/maids/indonesian-maids/')}>Indonesian maids <Icon name="arrow" size={16} /></a></li>
        <li><a href={href('/services/childcare-maid/')}>Childcare maid <Icon name="arrow" size={16} /></a></li>
        <li><a href={href('/blog/how-to-interview-a-domestic-helper/')}>How to interview a helper <Icon name="arrow" size={16} /></a></li>
        <li><a href={href('/faq/')}>Frequently asked questions <Icon name="arrow" size={16} /></a></li>
      </ul>
    </div>
  </section>
  <CtaBand title="Looking for a Filipino helper?" message={WA.filipino} />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MaidDirectory from '../../components/MaidDirectory.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { href } from '../../lib/urls';
import { getPublicMaids, DEMO } from '../../lib/maids';

const maids = await getPublicMaids();
---
<BaseLayout
  title="Maid Biodata Malaysia | Browse Domestic Helper Profiles | Final Choice"
  description="Browse published Indonesian and Filipino domestic helper biodata. Filter by experience in childcare, elderly care, cooking and housekeeping, then request an interview."
  path="/maids/"
  crumbs={[{ name: 'Find a Maid', path: '/maids/' }]}
  noindex={DEMO}
>
  <PageHero
    eyebrow="Find a maid"
    title="Browse domestic helper biodata"
    lead="Profiles of Indonesian and Filipino domestic helpers who have agreed to have their biodata published. Filter by experience, then request an interview with the candidates you like."
  />
  <section class="section section--tight">
    <div class="container">
      <MaidDirectory maids={maids} />
      <div class="callout" style="margin-top:32px">
        <Icon name="clock" size={20} />
        <p>
          Availability shown is the status recorded by our team on the date displayed on each profile. It is not real-time.
          Please contact us to confirm before making plans. Not every candidate is listed online, so ask us if you do not see a suitable match.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint section--tight">
    <div class="container grid grid--2">
      <a class="card card--link" href={href('/maids/indonesian-maids/')} style="text-decoration:none;color:inherit">
        <h2 style="font-size:1.3rem">Indonesian maids</h2>
        <p class="muted">How Indonesian helper recruitment works, typical strengths, and profiles currently published.</p>
        <span class="card__more">Explore Indonesian helpers <Icon name="arrow" size={18} /></span>
      </a>
      <a class="card card--link" href={href('/maids/filipino-maids/')} style="text-decoration:none;color:inherit">
        <h2 style="font-size:1.3rem">Filipino maids</h2>
        <p class="muted">How Filipino helper recruitment works, typical strengths, and profiles currently published.</p>
        <span class="card__more">Explore Filipino helpers <Icon name="arrow" size={18} /></span>
      </a>
    </div>
  </section>
  <CtaBand />
</BaseLayout>

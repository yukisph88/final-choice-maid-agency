---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MaidDirectory from '../../components/MaidDirectory.astro';
import PackageCards from '../../components/PackageCards.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { href, whatsappLink, WA } from '../../lib/urls';
import { getPublicMaids, DEMO } from '../../lib/maids';
import { serviceSchema } from '../../lib/schema';

const maids = (await getPublicMaids()).filter((m) => m.nationality === 'indonesian');
const desc = 'Hire an Indonesian maid in Malaysia with Final Choice. Browse Indonesian domestic helper biodata, arrange interviews and get guidance on documents and placement.';
---
<BaseLayout
  title="Indonesian Maid Agency Malaysia | Hire Indonesian Maid | Final Choice"
  description={desc}
  path="/maids/indonesian-maids/"
  crumbs={[{ name: 'Find a Maid', path: '/maids/' }, { name: 'Indonesian Maids', path: '/maids/indonesian-maids/' }]}
  waMessage={WA.indonesian}
  noindex={DEMO}
  schema={[serviceSchema({ name: 'Indonesian domestic helper recruitment', description: desc, path: '/maids/indonesian-maids/' })]}
>
  <PageHero
    eyebrow="Agensi pembantu rumah Indonesia"
    title="Hire an Indonesian maid in Malaysia"
    lead="Indonesian domestic helpers are a long-standing choice for Malaysian families. Final Choice helps you find a suitable candidate, interview her and complete the placement process step by step."
  >
    <div class="btn-row">
      <a class="btn btn--wa btn--lg" href={whatsappLink(WA.indonesian)} target="_blank" rel="noopener" data-track="indo_hero"><Icon name="whatsapp" size={20} /> Enquire about an Indonesian maid</a>
      <a class="btn btn--outline btn--lg" href="#profiles">See profiles</a>
    </div>
  </PageHero>

  <section class="section section--tight" id="profiles" aria-labelledby="p-h">
    <div class="container">
      <h2 id="p-h">Indonesian domestic helper profiles</h2>
      <MaidDirectory maids={maids} nationality="indonesian" waMessage={WA.indonesian} />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container split" style="align-items:start">
      <div class="prose">
        <h2>Why families choose Indonesian helpers</h2>
        <p>
          Many Indonesian helpers speak Bahasa Indonesia, which is close to Bahasa Malaysia, so day-to-day
          communication is often straightforward for Malaysian households. Food culture is also familiar, and many
          candidates are comfortable preparing Malaysian home-style meals or learning your family’s recipes.
        </p>
        <p>
          Indonesian candidates come with a wide range of backgrounds — from first-time helpers who have completed
          training to experienced helpers who have worked in Malaysia or elsewhere before. We help you weigh
          experience against your actual needs, such as caring for a newborn, supporting an elderly parent or running a busy home.
        </p>
        <h3>Religion and household considerations</h3>
        <p>
          Tell us about religious and dietary practices in your home. Muslim employers are generally required to hire
          Muslim helpers, and many families also have preferences about cooking pork or caring for pets. Sharing
          these early helps us recommend the right candidates.
        </p>
      </div>
      <div class="prose">
        <h2>How Indonesian maid recruitment works</h2>
        <p>
          Recruitment of Indonesian domestic workers follows the procedures agreed between the governments of Malaysia
          and Indonesia, which include checks on the employer and an employment contract that sets out salary, rest
          days and other working conditions. These procedures can change, so we confirm the current requirements with
          you at the start.
        </p>
        <ol>
          <li>Share your requirements and review suitable biodata</li>
          <li>Interview your shortlisted candidate</li>
          <li>Prepare your documents and the employment contract</li>
          <li>Application and approvals by the relevant authorities</li>
          <li>Arrival, FOMEMA medical examination and orientation</li>
          <li>Handover and after-placement support</li>
        </ol>
        <p><a href={href('/maid-hiring-process/')}>See the full hiring process</a> · <a href={href('/blog/documents-needed-to-hire-a-domestic-helper/')}>Documents you may need</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pk-h">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 id="pk-h">Indonesian maid packages</h2>
        <p>Compare Premium, Platinum and Diamond for Indonesian helpers. WhatsApp us for a confirmed quotation.</p>
      </div>
      <PackageCards only="indonesian" id="indo-packages" />
    </div>
  </section>

  <section class="section section--tint section--tight">
    <div class="container">
      <h2 style="font-size:1.4rem">Related pages</h2>
      <ul class="related-links">
        <li><a href={href('/maids/filipino-maids/')}>Filipino maids <Icon name="arrow" size={16} /></a></li>
        <li><a href={href('/blog/indonesian-maid-vs-filipino-maid/')}>Indonesian vs Filipino maid <Icon name="arrow" size={16} /></a></li>
        <li><a href={href('/services/elderly-care-maid/')}>Elderly care maid <Icon name="arrow" size={16} /></a></li>
        <li><a href={href('/faq/')}>Frequently asked questions <Icon name="arrow" size={16} /></a></li>
      </ul>
    </div>
  </section>
  <CtaBand title="Looking for an Indonesian helper?" message={WA.indonesian} />
</BaseLayout>

---
// Root address (/). Opens the language the visitor explicitly chose before (saved when they used the
// EN | BM switch); otherwise English. It never redirects based on browser language or user agent,
// so search engines always see the same behaviour. Both language homepages are linked for everyone.
import { site } from '../lib/config';
import { href, absUrl, asset } from '../lib/urls';
const en = href('/en/');
const ms = href('/ms/');
---
<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Final Choice | Maid Agency Malaysia · Agensi Pembantu Rumah</title>
    <meta name="description" content="Agensi Pekerjaan Final Choice — English | Bahasa Melayu" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={absUrl('/en/')} />
    <link rel="alternate" hreflang="en-MY" href={absUrl('/en/')} />
    <link rel="alternate" hreflang="ms-MY" href={absUrl('/ms/')} />
    <link rel="alternate" hreflang="x-default" href={absUrl('/en/')} />
    <link rel="icon" href={asset('favicon/favicon-48.png')} sizes="48x48" type="image/png" />
    <script is:inline define:vars={{ en, ms }}>
      var lang = 'en';
      try { lang = localStorage.getItem('fc-lang') === 'ms' ? 'ms' : 'en'; } catch (e) {}
      location.replace(lang === 'ms' ? ms : en);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${en}`} /></noscript>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, sans-serif; background: #fff; color: #0a1a5c; }
      main { text-align: center; padding: 24px; }
      img { width: 220px; height: auto; }
      a { display: inline-block; margin: 8px; padding: 12px 22px; border-radius: 999px; background: #0162c7; color: #fff; text-decoration: none; font-weight: 600; }
    </style>
  </head>
  <body>
    <main>
      <img src={asset('images/logo-final-choice.png')} alt={site.company.legalName} width="720" height="537" />
      <p><a href={en} hreflang="en-MY" lang="en-MY">English</a><a href={ms} hreflang="ms-MY" lang="ms-MY">Bahasa Melayu</a></p>
    </main>
  </body>
</html>

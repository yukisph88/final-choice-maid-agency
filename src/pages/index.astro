---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import MaidCard from '../components/MaidCard.astro';
import PackageCards from '../components/PackageCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FaqList from '../components/FaqList.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, testimonials } from '../lib/config';
import { href, asset, whatsappLink, telLink, WA } from '../lib/urls';
import { getPublicMaids } from '../lib/maids';
import { organizationSchema, websiteSchema } from '../lib/schema';

const maids = await getPublicMaids();
// Featured first, then other available profiles. Only candidates who can currently be interviewed.
const showable = maids.filter((m) => m.status === 'available' || m.status === 'interview-pending');
const featured = [...showable.filter((m) => m.featured), ...showable.filter((m) => !m.featured && m.status === 'available')].slice(0, 8);
const c = site.company;
const areas = c.serviceAreas.join(' and ');

const sectionNav = [
  { id: 'services', label: 'Services' },
  { id: 'indonesian-maid', label: 'Indonesian maid' },
  { id: 'philippines-maid', label: 'Philippines maid' },
  { id: 'process', label: 'Process' },
  { id: 'requirements', label: 'Documents' },
  { id: 'packages', label: 'Packages' },
  { id: 'arrival', label: 'Arrival & FOMEMA' },
  { id: 'faq', label: 'FAQ' },
  { id: 'enquire', label: 'Contact' },
];

const strengths = [
  { icon: 'users', title: 'Personalised helper recommendations', text: 'We listen to your household’s needs first, then recommend candidates whose experience fits — not simply whoever is next on the list.' },
  { icon: 'chat', title: 'Interview before you decide', text: 'Speak with your shortlisted helper, usually by video call, so you can choose with confidence before committing.' },
  { icon: 'file', title: 'Clear documentation guidance', text: 'A checklist for your case and help with the contract and application forms, so nothing is missed.' },
  { icon: 'clipboard', title: 'Placement handled step by step', text: 'We coordinate the application, approvals follow-up, travel and arrival, and keep you informed throughout.' },
  { icon: 'graduation', title: 'Orientation before handover', text: 'Helpers receive an orientation on household expectations and practical working arrangements before joining you.' },
  { icon: 'handshake', title: 'Support after placement', text: 'We stay in touch after your helper arrives, and help with permit and contract renewal when the time comes.' },
];

const services = [
  { icon: 'baby', title: 'Childcare & newborn helpers', text: 'Helpers with experience caring for babies, toddlers and school-going children.', path: '/services/childcare-maid/' },
  { icon: 'elderly', title: 'Elderly care helpers', text: 'Daily support and companionship for parents or grandparents living at home.', path: '/services/elderly-care-maid/' },
  { icon: 'sparkle', title: 'Housekeeping & cooking', text: 'Cleaning, laundry, ironing and family meals for a well-kept home.', path: '/services/housekeeping-maid/' },
  { icon: 'home', title: 'Domestic helper placement', text: 'End-to-end recruitment: matching, interview, documents, approvals, arrival and handover.', path: '/maid-hiring-process/' },
  { icon: 'refresh', title: 'Permit & contract renewal', text: 'Guidance on renewing your helper’s work permit and employment contract on time.', path: '/services/#permit-renewal' },
  { icon: 'swap', title: 'Replacement assistance', text: 'Options if a placement does not work out, according to your package and service agreement.', path: '/services/#replacement' },
];

const documents = [
  { title: 'Identification', text: 'A clear copy of your MyKad (front and back), and in some cases your spouse’s.' },
  { title: 'Proof of income', text: 'Recent salary slips, an EA form or bank statements. Business owners may provide business income documents.' },
  { title: 'Proof of address', text: 'A recent utility bill or another document showing your home address.' },
  { title: 'Household documents', text: 'Depending on your case, a marriage certificate or children’s birth certificates.' },
];

const arrival = [
  { icon: 'graduation', title: 'Preparation before departure', text: 'Before travelling, helpers complete the preparation and documentation required by their home country’s rules.' },
  { icon: 'plane', title: 'Arrival in Malaysia', text: 'Travel is arranged once approvals are in place. We keep you informed about the expected arrival.' },
  { icon: 'shield', title: 'FOMEMA medical examination', text: 'After arrival, your helper must complete a medical examination at a FOMEMA-registered clinic.' },
  { icon: 'clipboard', title: 'Work-pass formalities', text: 'The remaining work-pass steps are completed with the authorities after the medical result.' },
  { icon: 'users', title: 'Orientation by Final Choice', text: 'Before handover, we brief the helper on household expectations and practical working arrangements.' },
  { icon: 'handshake', title: 'Handover & follow-up', text: 'We hand over your helper, explain key documents, and remain available for questions.' },
];

const trust = [
  { icon: 'shield', title: 'Licensed employment agency', text: `Private employment agency licence ${c.licence}.` },
  { icon: 'file', title: 'Registered Malaysian company', text: `${c.legalName}, Company No. ${c.registrationNo}.` },
  { icon: 'pin', title: 'Office you can visit', text: `${c.address.street}, ${c.address.postcode} ${c.address.city}.` },
  { icon: 'clipboard', title: 'Prices shown up front', text: 'Reference package prices are published, and final terms are confirmed in writing before you commit.' },
];
---
<BaseLayout
  title="Maid Agency Malaysia | Indonesian & Filipino Maids | Final Choice"
  description="Licensed maid agency in Kuala Lumpur helping families in KL and Selangor hire Indonesian and Philippines domestic helpers. Browse biodata and WhatsApp us."
  path="/"
  schema={[organizationSchema(), websiteSchema()]}
>
  <!-- 1. HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">Maid agency in Kuala Lumpur{areas ? ` · serving ${areas}` : ''}</p>
        <h1>Find the Right <span>Domestic Helper</span> for Your Family</h1>
        <p class="lead">
          Explore Indonesian and Filipino domestic helpers with Agensi Pekerjaan Final Choice. Our team assists
          Malaysian employers with helper selection, interviews, documentation and placement arrangements.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href={href('/maids/')}>Browse Available Maids <Icon name="arrow" size={18} /></a>
          <a class="btn btn--wa btn--lg" href={whatsappLink(WA.home)} target="_blank" rel="noopener" data-track="hero_whatsapp"><Icon name="whatsapp" size={20} /> WhatsApp Our Consultant</a>
        </div>
        <ul class="hero__trust">
          <li><Icon name="shield" size={18} /> Licence {c.licence}</li>
          <li><Icon name="check" size={18} /> Indonesian &amp; Filipino helpers</li>
          <li><Icon name="check" size={18} /> Interview before you decide</li>
        </ul>
      </div>
      <div class="hero__media">
        <div class="hero__photo">
          <picture>
            <source media="(max-width: 700px)" srcset={asset('images/home-helper-housekeeping-640.webp')} type="image/webp" />
            <img src={asset('images/home-helper-housekeeping-1024.webp')} alt="Two domestic helpers neatly making a bed together in a bright bedroom" width="1024" height="640" fetchpriority="high" />
          </picture>
        </div>
        <div class="hero__badge">
          <Icon name="calendar" size={28} />
          <span><strong>Two-year contracts</strong>Terms explained clearly before you sign.</span>
        </div>
      </div>
    </div>
  </section>

  <nav class="section-nav" aria-label="On this page">
    <div class="container">
      <ul>{sectionNav.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}</ul>
    </div>
  </nav>

  <!-- 2. WHY CHOOSE FINAL CHOICE -->
  <section class="section section--tint" aria-labelledby="why-h" id="why">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Why choose Final Choice</p>
        <h2 id="why-h">Practical support at every step of hiring a helper</h2>
        <p>Hiring a domestic helper is a big decision for any family. We focus on careful matching, clear explanations and steady follow-up.</p>
      </div>
      <div class="grid grid--3">
        {strengths.map((s) => (
          <div class="card">
            <span class="card__icon"><Icon name={s.icon} size={24} /></span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. SERVICES -->
  <section class="section" aria-labelledby="svc-h" id="services">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Maid &amp; domestic helper services</p>
        <h2 id="svc-h">Help for every kind of household</h2>
        <p>From childcare to elderly care and renewals, our services cover the whole time you employ a helper. Actual suitability always depends on each candidate’s confirmed skills and experience.</p>
      </div>
      <div class="grid grid--3">
        {services.map((n) => (
          <div class="card card--link need-card">
            <span class="card__icon"><Icon name={n.icon} size={24} /></span>
            <div>
              <h3><a class="stretched" href={href(n.path)}>{n.title}</a></h3>
              <p>{n.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. INDONESIAN MAID -->
  <section class="section section--tint" aria-labelledby="indo-h" id="indonesian-maid">
    <div class="container nat-feature">
      <div class="nat-feature__label" aria-hidden="true"><span>ID</span>Indonesia</div>
      <div>
        <p class="eyebrow">Agensi pembantu rumah Indonesia</p>
        <h2 id="indo-h">Indonesian maid for Malaysian families</h2>
        <p class="lead">
          Indonesian domestic helpers are a long-standing choice for families in Malaysia. Many speak Bahasa Indonesia, which is
          close to Bahasa Malaysia, and are familiar with local home cooking.
        </p>
        <ul class="ticks ticks--2col">
          <li><Icon name="check" size={18} />Candidates with childcare, elderly-care and housekeeping experience</li>
          <li><Icon name="check" size={18} />Placement following current Malaysia–Indonesia procedures</li>
          <li><Icon name="check" size={18} />Package terms specific to Indonesian helpers</li>
          <li><Icon name="check" size={18} />Interview your shortlisted candidate before deciding</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href={href('/maids/indonesian-maids/')}>Indonesian maids <Icon name="arrow" size={18} /></a>
          <a class="btn btn--wa-outline" href={whatsappLink(WA.indonesian)} target="_blank" rel="noopener" data-track="home_indonesian"><Icon name="whatsapp" size={18} /> Enquire about an Indonesian maid</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. PHILIPPINES MAID -->
  <section class="section" aria-labelledby="ph-h" id="philippines-maid">
    <div class="container nat-feature nat-feature--reverse">
      <div class="nat-feature__label" aria-hidden="true"><span>PH</span>Philippines</div>
      <div>
        <p class="eyebrow">Agensi pembantu rumah Filipina</p>
        <h2 id="ph-h">Philippines maid for English-speaking homes</h2>
        <p class="lead">
          Filipino domestic helpers are valued by many Malaysian families for their English communication and caregiving
          experience, including helpers who have worked overseas before.
        </p>
        <ul class="ticks ticks--2col">
          <li><Icon name="check" size={18} />Many candidates communicate comfortably in English</li>
          <li><Icon name="check" size={18} />Experience in childcare, elderly care and housekeeping</li>
          <li><Icon name="check" size={18} />Documentation guided according to Philippine requirements</li>
          <li><Icon name="check" size={18} />Package terms specific to Filipino helpers</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href={href('/maids/filipino-maids/')}>Filipino maids <Icon name="arrow" size={18} /></a>
          <a class="btn btn--wa-outline" href={whatsappLink(WA.filipino)} target="_blank" rel="noopener" data-track="home_filipino"><Icon name="whatsapp" size={18} /> Enquire about a Filipino maid</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured maid biodata -->
  <section class="section section--tint" aria-labelledby="feat-h" id="biodata">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Maid biodata</p>
        <h2 id="feat-h">{featured.length ? 'Featured helper profiles' : 'Ask for current helper biodata'}</h2>
        <p>
          {featured.length
            ? 'A selection of published profiles. Availability changes quickly, so please confirm the current status with our consultant.'
            : 'We publish profiles only with each candidate’s consent. Tell us what you need and our consultant will share suitable biodata directly.'}
        </p>
      </div>
      {featured.length > 0 ? (
        <>
          <div class="maid-grid">{featured.map((m) => <MaidCard maid={m} />)}</div>
          <p style="margin-top:28px"><a class="btn btn--outline" href={href('/maids/')}>View all maid biodata <Icon name="arrow" size={18} /></a></p>
        </>
      ) : (
        <div class="empty-state">
          <Icon name="file" size={40} />
          <h3>Receive suitable biodata on WhatsApp</h3>
          <p>Share your household needs and preferred nationality. We will send profiles of candidates who match, and arrange interviews with those you shortlist.</p>
          <div class="btn-row" style="justify-content:center">
            <a class="btn btn--wa" href={whatsappLink('Hi Final Choice, please share suitable domestic helper biodata for my family.')} target="_blank" rel="noopener" data-track="featured_empty"><Icon name="whatsapp" size={18} /> Request biodata</a>
            <a class="btn btn--outline" href={href('/maids/')}>Go to maid directory</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 6. PROCESS -->
  <section class="section" aria-labelledby="proc-h" id="process">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How the process works</p>
        <h2 id="proc-h">From first conversation to handover in seven steps</h2>
      </div>
      <ProcessSteps />
      <p style="margin-top:24px"><a class="card__more" href={href('/maid-hiring-process/')}>Read the full maid hiring process <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <!-- 7. EMPLOYER REQUIREMENTS / DOCUMENTS -->
  <section class="section section--tint" aria-labelledby="req-h" id="requirements">
    <div class="container split" style="align-items:start">
      <div>
        <p class="eyebrow">Employer requirements</p>
        <h2 id="req-h">What employers need to prepare</h2>
        <p class="muted">
          Employers must meet the eligibility criteria set by the Immigration Department of Malaysia, which include income
          requirements, and the rules that apply to the helper’s nationality. For example, Muslim employers are generally
          required to hire Muslim helpers.
        </p>
        <p class="muted">Requirements are updated from time to time, so we confirm the current checklist for your case before you start.</p>
        <div class="callout" style="margin-top:20px">
          <Icon name="shield" size={20} />
          <p>Please don’t send identity documents in your first WhatsApp message. We will tell you how to share them securely.</p>
        </div>
        <p style="margin-top:20px"><a class="card__more" href={href('/blog/documents-needed-to-hire-a-domestic-helper/')}>Full guide: documents needed to hire a domestic helper <Icon name="arrow" size={18} /></a></p>
      </div>
      <div class="doc-list">
        <h3 class="doc-list__title">Documents commonly requested</h3>
        <ol>
          {documents.map((d) => (
            <li><strong>{d.title}</strong><span>{d.text}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 8. PACKAGES -->
  <section class="section" aria-labelledby="pkg-h" id="packages">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Packages &amp; service options</p>
        <h2 id="pkg-h">Premium, Platinum and Diamond packages</h2>
        <p>Package terms differ for Indonesian and Filipino helpers. Select a nationality to compare, then WhatsApp us for an accurate quotation.</p>
      </div>
      <PackageCards id="home-packages" />
    </div>
  </section>

  <!-- 9. TRAINING / FOMEMA / ARRIVAL -->
  <section class="section section--navy" aria-labelledby="arr-h" id="arrival">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Training, FOMEMA &amp; arrival</p>
        <h2 id="arr-h">What happens before your helper joins you</h2>
        <p>After approvals, there are a few important steps before handover. Here is what to expect.</p>
      </div>
      <ol class="timeline">
        {arrival.map((a, i) => (
          <li class="timeline__item">
            <span class="timeline__icon"><Icon name={a.icon} size={22} /></span>
            <h3><span class="sr-only">Step {i + 1}: </span>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))}
      </ol>
      <p style="margin-top:28px"><a class="card__more card__more--light" href={href('/blog/what-happens-after-your-maid-arrives-in-malaysia/')}>What happens after your maid arrives <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <!-- 10. TRUST -->
  <section class="section" aria-labelledby="trust-h" id="trust">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Why families can trust us</p>
        <h2 id="trust-h">A licensed, registered agency with a real office</h2>
      </div>
      <div class="grid grid--4">
        {trust.map((t) => (
          <div class="card trust-card">
            <span class="card__icon"><Icon name={t.icon} size={24} /></span>
            <h3>{t.title}</h3>
            <p class="muted">{t.text}</p>
          </div>
        ))}
      </div>
      {testimonials.length > 0 && (
        <div class="testimonials">
          <h3 class="testimonials__h">What employers say</h3>
          <div class="grid grid--3">
            {testimonials.map((t) => (
              <figure class="card testimonial">
                <blockquote><p>“{t.text}”</p></blockquote>
                <figcaption>{t.name}{t.location && `, ${t.location}`}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}
      {site.social.googleBusinessProfile && (
        <p style="text-align:center;margin-top:28px"><a class="btn btn--outline" href={site.social.googleBusinessProfile} target="_blank" rel="noopener">Read our reviews on Google <Icon name="arrow" size={18} /></a></p>
      )}
    </div>
  </section>

  <!-- 11. FAQ -->
  <section class="section section--tint" aria-labelledby="faq-h" id="faq">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h">Questions employers often ask</h2>
      </div>
      <FaqList homeOnly />
      <p style="text-align:center;margin-top:24px"><a class="card__more" href={href('/faq/')}>See all questions <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <!-- 12. WHATSAPP / ENQUIRY CTA -->
  <section class="cta-band" aria-labelledby="cta-h">
    <div class="container cta-band__inner">
      <div>
        <h2 id="cta-h">Ready to find your domestic helper?</h2>
        <p>WhatsApp our consultant with your household’s needs. We will recommend suitable helpers and explain the next steps, costs and documents.</p>
      </div>
      <div class="cta-band__actions">
        <a class="btn btn--wa btn--lg" href={whatsappLink(WA.home)} target="_blank" rel="noopener" data-track="cta_band"><Icon name="whatsapp" size={20} /> WhatsApp {site.contact.consultantName}</a>
        <a class="btn btn--ghost-light btn--lg" href={telLink} data-track="cta_band_call"><Icon name="phone" size={18} /> Call {site.contact.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <!-- 13. COMPANY INFORMATION + ENQUIRY -->
  <section class="section section--tint" aria-labelledby="contact-h" id="enquire">
    <div class="container contact-grid">
      <div class="info-panel info-panel--white">
        <picture>
          <source srcset={asset('images/logo-final-choice.webp')} type="image/webp" />
          <img class="info-panel__logo" src={asset('images/logo-final-choice.png')} alt="Agensi Pekerjaan Final Choice Sdn Bhd official logo" width="720" height="537" loading="lazy" decoding="async" />
        </picture>
        <h2 id="contact-h">Agensi Pekerjaan Final Choice Sdn Bhd</h2>
        <p class="muted">
          A licensed private employment agency in Kuala Lumpur, helping families{areas ? ` in ${areas}` : ''} recruit Indonesian and
          Filipino domestic helpers, and assisting with permit and contract renewal after placement.
          <a href={href('/about-us/')}>About us</a>
        </p>
        <ul class="contact-list">
          <li><Icon name="whatsapp" size={20} /><a href={whatsappLink(WA.home)} target="_blank" rel="noopener" data-track="contact_whatsapp">WhatsApp {site.contact.consultantName}: {site.contact.phoneDisplay}</a></li>
          <li><Icon name="phone" size={20} /><a href={telLink} data-track="contact_phone">Call {site.contact.phoneDisplay}</a></li>
          <li><Icon name="mail" size={20} /><a href={`mailto:${c.email}`}>{c.email}</a></li>
          <li><Icon name="pin" size={20} /><span>{c.address.street}, {c.address.postcode} {c.address.city}<br /><a href={c.mapsUrl} target="_blank" rel="noopener">Get directions</a></span></li>
          <li><Icon name="clock" size={20} /><span>{c.hours.map((h) => <>{h.label}: {h.opens}–{h.closes}<br /></>)}</span></li>
        </ul>
        <div class="licence-box">
          <span><strong>Company No.</strong> {c.registrationNo}</span>
          <span><strong>Licence</strong> {c.licence}</span>
        </div>
      </div>
      <div>
        <h2 class="h3-size">Send an enquiry</h2>
        <p class="muted">Tell us a little about your household. Your enquiry opens in WhatsApp, ready to send.</p>
        <EnquiryForm idPrefix="home" />
      </div>
    </div>
  </section>
</BaseLayout>

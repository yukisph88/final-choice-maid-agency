const sectionIds = ['services', 'indonesian-maid', 'filipino-maid', 'process', 'requirements', 'packages', 'arrival', 'faq', 'enquire'];
---
<BaseLayout lang={lang} title={C.title} description={C.description} path={path(lang, 'home')} alternates={routeAlternates('home')} schema={[organizationSchema(lang), websiteSchema(lang)]}>
  <!-- 1. HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">{C.eyebrow}</p>
        <h1>{C.h1a}<span>{C.h1b}</span>{C.h1c}</h1>
        <p class="lead">{C.lead}</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href={p('maids')}>{T.btn.browseMaids} <Icon name="arrow" size={18} /></a>
          <a class="btn btn--wa btn--lg" href={whatsappLink(T.wa.home)} target="_blank" rel="noopener" data-track="hero_whatsapp"><Icon name="whatsapp" size={20} /> {T.btn.whatsappConsultant}</a>
        </div>
        <ul class="hero__trust">
          <li><Icon name="shield" size={18} /> {C.trust1}</li>
          <li><Icon name="check" size={18} /> {C.trust2}</li>
          <li><Icon name="check" size={18} /> {C.trust3}</li>
        </ul>
      </div>
      <div class="hero__media">
        <div class="hero__photo">
          <picture>
            <source media="(max-width: 700px)" srcset={asset('images/home-helper-housekeeping-640.webp')} type="image/webp" />
            <img src={asset('images/home-helper-housekeeping-1024.webp')} alt={C.heroAlt} width="1024" height="640" fetchpriority="high" />
          </picture>
        </div>
        <div class="hero__badge">
          <Icon name="calendar" size={28} />
          <span><strong>{C.badgeT}</strong>{C.badgeX}</span>
        </div>
      </div>
    </div>
  </section>

  <nav class="section-nav" aria-label={C.onPage}>
    <div class="container">
      <ul>{sectionIds.map((id, i) => <li><a href={`#${id}`}>{C.nav[i]}</a></li>)}</ul>
    </div>
  </nav>

  <!-- 2. WHY CHOOSE FINAL CHOICE -->
  <section class="section section--tint" aria-labelledby="why-h" id="why">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">{C.whyE}</p>
        <h2 id="why-h">{C.whyH}</h2>
        <p>{C.whyP}</p>
      </div>
      <div class="grid grid--3">
        {C.strengths.map(([icon, title, text]) => (
          <div class="card">
            <span class="card__icon"><Icon name={icon} size={24} /></span>
            <h3>{title}</h3>
            <p class="muted">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. SERVICES -->
  <section class="section" aria-labelledby="svc-h" id="services">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{C.svcE}</p>
        <h2 id="svc-h">{C.svcH}</h2>
        <p>{C.svcP}</p>
      </div>
      <div class="grid grid--3">
        {C.services.map(([icon, title, text, key, hash]) => (
          <div class="card card--link need-card">
            <span class="card__icon"><Icon name={icon} size={24} /></span>
            <div>
              <h3><a class="stretched" href={p(key as Parameters<typeof path>[1], hash)}>{title}</a></h3>
              <p>{text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. INDONESIAN MAID -->
  <section class="section section--tint" aria-labelledby="indo-h" id="indonesian-maid">
    <div class="container nat-feature">
      <div class="nat-feature__label" aria-hidden="true"><span>ID</span>Indonesia</div>
      <div>
        <p class="eyebrow">{C.idE}</p>
        <h2 id="indo-h">{C.idH}</h2>
        <p class="lead">{C.idP}</p>
        <ul class="ticks ticks--2col">{C.idL.map((x) => <li><Icon name="check" size={18} />{x}</li>)}</ul>
        <div class="btn-row">
          <a class="btn btn--primary" href={p('indonesian')}>{C.idB1} <Icon name="arrow" size={18} /></a>
          <a class="btn btn--wa-outline" href={whatsappLink(T.wa.indonesian)} target="_blank" rel="noopener" data-track="home_indonesian"><Icon name="whatsapp" size={18} /> {C.idB2}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FILIPINO MAID -->
  <section class="section" aria-labelledby="ph-h" id="filipino-maid">
    <div class="container nat-feature nat-feature--reverse">
      <div class="nat-feature__label" aria-hidden="true"><span>PH</span>{lang === 'ms' ? 'Filipina' : 'Philippines'}</div>
      <div>
        <p class="eyebrow">{C.phE}</p>
        <h2 id="ph-h">{C.phH}</h2>
        <p class="lead">{C.phP}</p>
        <ul class="ticks ticks--2col">{C.phL.map((x) => <li><Icon name="check" size={18} />{x}</li>)}</ul>
        <div class="btn-row">
          <a class="btn btn--primary" href={p('filipino')}>{C.phB1} <Icon name="arrow" size={18} /></a>
          <a class="btn btn--wa-outline" href={whatsappLink(T.wa.filipino)} target="_blank" rel="noopener" data-track="home_filipino"><Icon name="whatsapp" size={18} /> {C.phB2}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured maid biodata -->
  <section class="section section--tint" aria-labelledby="feat-h" id="biodata">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{C.bioE}</p>
        <h2 id="feat-h">{featured.length ? C.bioH1 : C.bioH0}</h2>
        <p>{featured.length ? C.bioP1 : C.bioP0}</p>
      </div>
      {featured.length > 0 ? (
        <>
          <div class="maid-grid">{featured.map((m) => <MaidCard maid={m} lang={lang} />)}</div>
          <p style="margin-top:28px"><a class="btn btn--outline" href={p('maids')}>{T.btn.allBiodata} <Icon name="arrow" size={18} /></a></p>
        </>
      ) : (
        <div class="empty-state">
          <Icon name="file" size={40} />
          <h3>{C.bioEmptyH}</h3>
          <p>{C.bioEmptyP}</p>
          <div class="btn-row" style="justify-content:center">
            <a class="btn btn--wa" href={whatsappLink(T.wa.biodata)} target="_blank" rel="noopener" data-track="featured_empty"><Icon name="whatsapp" size={18} /> {T.btn.requestBiodata}</a>
            <a class="btn btn--outline" href={p('maids')}>{T.btn.toDirectory}</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 6. PROCESS -->
  <section class="section" aria-labelledby="proc-h" id="process">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{C.procE}</p>
        <h2 id="proc-h">{C.procH}</h2>
      </div>
      <ProcessSteps lang={lang} />
      <p style="margin-top:24px"><a class="card__more" href={p('process')}>{C.procLink} <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <!-- 7. EMPLOYER REQUIREMENTS / DOCUMENTS -->
  <section class="section section--tint" aria-labelledby="req-h" id="requirements">
    <div class="container split" style="align-items:start">
      <div>
        <p class="eyebrow">{C.reqE}</p>
        <h2 id="req-h">{C.reqH}</h2>
        <p class="muted">{C.reqP1}</p>
        <p class="muted">{C.reqP2}</p>
        <div class="callout" style="margin-top:20px">
          <Icon name="shield" size={20} />
          <p>{C.reqNote}</p>
        </div>
        <p style="margin-top:20px"><a class="card__more" href={href(withLang(lang, postPath(lang, docsGuide)))}>{C.reqLink} <Icon name="arrow" size={18} /></a></p>
      </div>
      <div class="doc-list">
        <h3 class="doc-list__title">{C.docsH}</h3>
        <ol>{C.docs.map(([title, text]) => <li><strong>{title}</strong><span>{text}</span></li>)}</ol>
      </div>
    </div>
  </section>

  <!-- 8. PACKAGES -->
  <section class="section" aria-labelledby="pkg-h" id="packages">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">{C.pkgE}</p>
        <h2 id="pkg-h">{C.pkgH}</h2>
        <p>{C.pkgP}</p>
      </div>
      <PackageCards lang={lang} id="home-packages" />
    </div>
  </section>

  <!-- 9. TRAINING / FOMEMA / ARRIVAL -->
  <section class="section section--navy" aria-labelledby="arr-h" id="arrival">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{C.arrE}</p>
        <h2 id="arr-h">{C.arrH}</h2>
        <p>{C.arrP}</p>
      </div>
      <ol class="timeline">
        {C.arrival.map(([icon, title, text], i) => (
          <li class="timeline__item">
            <span class="timeline__icon"><Icon name={icon} size={22} /></span>
            <h3><span class="sr-only">{T.process.step} {i + 1}: </span>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <p style="margin-top:28px"><a class="card__more card__more--light" href={href(withLang(lang, postPath(lang, arrivalGuide)))}>{C.arrLink} <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <!-- 10. TRUST -->
  <section class="section" aria-labelledby="trust-h" id="trust">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">{C.trustE}</p>
        <h2 id="trust-h">{C.trustH}</h2>
      </div>
      <div class="grid grid--4">
        {C.trust.map(([icon, title, text]) => (
          <div class="card trust-card">
            <span class="card__icon"><Icon name={icon} size={24} /></span>
            <h3>{title}</h3>
            <p class="muted">{text}</p>
          </div>
        ))}
      </div>
      {testimonials.length > 0 && (
        <div class="testimonials">
          <h3 class="testimonials__h">{C.testiH}</h3>
          <div class="grid grid--3">
            {testimonials.map((x) => (
              <figure class="card testimonial">
                <blockquote><p>“{x.text}”</p></blockquote>
                <figcaption>{x.name}{x.location && `, ${x.location}`}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}
      {site.social.googleBusinessProfile && (
        <p style="text-align:center;margin-top:28px"><a class="btn btn--outline" href={site.social.googleBusinessProfile} target="_blank" rel="noopener">{C.reviews} <Icon name="arrow" size={18} /></a></p>
      )}
    </div>
  </section>

  <!-- 11. FAQ -->
  <section class="section section--tint" aria-labelledby="faq-h" id="faq">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">{C.faqE}</p>
        <h2 id="faq-h">{C.faqH}</h2>
      </div>
      <FaqList lang={lang} homeOnly />
      <p style="text-align:center;margin-top:24px"><a class="card__more" href={p('faq')}>{T.btn.allQuestions} <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <!-- 12. WHATSAPP / ENQUIRY CTA -->
  <CtaBand lang={lang} title={C.ctaH} text={C.ctaP} headingId="cta-h" />

  <!-- 13. COMPANY INFORMATION + ENQUIRY -->
  <section class="section section--tint" aria-labelledby="contact-h" id="enquire">
    <div class="container contact-grid">
      <div class="info-panel info-panel--white">
        <picture>
          <source srcset={asset('images/logo-final-choice.webp')} type="image/webp" />
          <img class="info-panel__logo" src={asset('images/logo-final-choice.png')} alt={C.logoAlt} width="720" height="537" loading="lazy" decoding="async" />
        </picture>
        <h2 id="contact-h">{c.legalName}</h2>
        <p class="muted">{C.infoP} <a href={p('about')}>{T.btn.aboutUs}</a></p>
        <ul class="contact-list">
          <li><Icon name="whatsapp" size={20} /><a href={whatsappLink(T.wa.home)} target="_blank" rel="noopener" data-track="contact_whatsapp">WhatsApp {site.contact.consultantName}: {site.contact.phoneDisplay}</a></li>
          <li><Icon name="phone" size={20} /><a href={telLink} data-track="contact_phone">{T.btn.call} {site.contact.phoneDisplay}</a></li>
          <li><Icon name="mail" size={20} /><a href={`mailto:${c.email}`}>{c.email}</a></li>
          <li><Icon name="pin" size={20} /><span>{c.address.street}, {c.address.postcode} {c.address.city}<br /><a href={c.mapsUrl} target="_blank" rel="noopener">{T.btn.directions}</a></span></li>
          <li><Icon name="clock" size={20} /><span>{hours.map((h) => <>{h.label}: {h.opens}–{h.closes}<br /></>)}</span></li>
        </ul>
        <div class="licence-box">
          <span><strong>{T.footer.companyNo}</strong> {c.registrationNo}</span>
          <span><strong>{lang === 'ms' ? 'Lesen' : 'Licence'}</strong> {c.licence}</span>
        </div>
      </div>
      <div>
        <h2 class="h3-size">{C.enqH}</h2>
        <p class="muted">{C.enqP}</p>
        <EnquiryForm lang={lang} idPrefix="home" />
      </div>
    </div>
  </section>
</BaseLayout>

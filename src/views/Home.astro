---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import MaidCard from '../components/MaidCard.astro';
import PackageCards from '../components/PackageCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FaqList from '../components/FaqList.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, testimonials } from '../lib/config';
import { href, asset, whatsappLink, telLink } from '../lib/urls';
import { getPublicMaids } from '../lib/maids';
import { organizationSchema, websiteSchema } from '../lib/schema';
import { path, routeAlternates, postPath, withLang, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const p = (k: Parameters<typeof path>[1], hash = '') => href(path(lang, k, hash));

const maids = await getPublicMaids();
// Featured first, then other available profiles. Only candidates who can currently be interviewed.
const showable = maids.filter((m) => m.status === 'available' || m.status === 'interview-pending');
const featured = [...showable.filter((m) => m.featured), ...showable.filter((m) => !m.featured && m.status === 'available')].slice(0, 8);
const c = site.company;
const areas = c.serviceAreas.join(lang === 'ms' ? ' dan ' : ' and ');
const hours = c.hours.map((h) => ({ label: T.hours[h.label] ?? h.label, opens: h.opens, closes: h.closes }));
const docsGuide = lang === 'ms' ? 'dokumen-untuk-mengambil-pembantu-rumah' : 'documents-needed-to-hire-a-domestic-helper';
const arrivalGuide = lang === 'ms' ? 'selepas-pembantu-rumah-tiba-di-malaysia' : 'what-happens-after-your-maid-arrives-in-malaysia';

const C = {
  en: {
    title: 'Maid Agency Malaysia | Indonesian & Filipino Maids | Final Choice',
    description: 'Licensed maid agency in Kuala Lumpur helping families in KL and Selangor hire Indonesian and Filipino domestic helpers. Browse maid biodata and WhatsApp us.',
    eyebrow: `Maid agency in Kuala Lumpur${areas ? ` · serving ${areas}` : ''}`,
    h1a: 'Find the Right ', h1b: 'Domestic Helper', h1c: ' for Your Family',
    lead: 'Explore Indonesian and Filipino domestic helpers with Agensi Pekerjaan Final Choice. Our team assists Malaysian employers with helper selection, interviews, documentation and placement arrangements.',
    trust1: `Licence ${c.licence}`, trust2: 'Indonesian & Filipino helpers', trust3: 'Interview before you decide',
    heroAlt: 'Two domestic helpers neatly making a bed together in a bright bedroom',
    badgeT: 'Two-year contracts', badgeX: 'Terms explained clearly before you sign.',
    onPage: 'On this page',
    nav: ['Services', 'Indonesian maid', 'Filipino maid', 'Process', 'Documents', 'Packages', 'Arrival & FOMEMA', 'FAQ', 'Contact'],
    whyE: 'Why choose Final Choice', whyH: 'Practical support at every step of hiring a helper',
    whyP: 'Hiring a domestic helper is a big decision for any family. We focus on careful matching, clear explanations and steady follow-up.',
    strengths: [
      ['users', 'Personalised helper recommendations', 'We listen to your household’s needs first, then recommend candidates whose experience fits — not simply whoever is next on the list.'],
      ['chat', 'Interview before you decide', 'Speak with your shortlisted helper, usually by video call, so you can choose with confidence before committing.'],
      ['file', 'Clear documentation guidance', 'A checklist for your case and help with the contract and application forms, so nothing is missed.'],
      ['clipboard', 'Placement handled step by step', 'We coordinate the application, approvals follow-up, travel and arrival, and keep you informed throughout.'],
      ['graduation', 'Orientation before handover', 'Helpers receive an orientation on household expectations and practical working arrangements before joining you.'],
      ['handshake', 'Support after placement', 'We stay in touch after your helper arrives, and help with permit and contract renewal when the time comes.'],
    ],
    svcE: 'Maid & domestic helper services', svcH: 'Help for every kind of household',
    svcP: 'From childcare to elderly care and renewals, our services cover the whole time you employ a helper. Actual suitability always depends on each candidate’s confirmed skills and experience.',
    services: [
      ['baby', 'Childcare & newborn helpers', 'Helpers with experience caring for babies, toddlers and school-going children.', 'childcare', ''],
      ['elderly', 'Elderly care helpers', 'Daily support and companionship for parents or grandparents living at home.', 'elderly', ''],

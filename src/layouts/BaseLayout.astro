---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '../styles/global.css';
// Preload the two fonts used above the fold so headings don't re-wrap when fonts arrive (layout shift).
import fontHeading from '@fontsource/montserrat/files/montserrat-latin-800-normal.woff2?url';
import fontBody from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../lib/config';
import { absUrl, asset } from '../lib/urls';
import { breadcrumbSchema, type Crumb } from '../lib/schema';
import { HTML_LANG, OG_LOCALE, LANGS, path, type Lang, type Alternates } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string; // canonical site path including language prefix, e.g. '/ms/pembantu-rumah/'
  alternates?: Alternates; // equivalent page in each language (for hreflang + switcher)
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: object[];
  crumbs?: Crumb[]; // excluding Home
  waMessage?: string;
}

const { lang, title, description, path: pagePath, alternates = {}, ogImage, ogType = 'website', noindex = false, schema = [], crumbs, waMessage } = Astro.props;
const T = t(lang);
const canonical = absUrl(pagePath); // always self-referencing — Malay pages are never canonicalised to English
const image = new URL(asset(ogImage ?? site.seo.defaultOgImage), Astro.site).toString();
const indexable = site.seo.indexing && !noindex && import.meta.env.PUBLIC_REVIEW_MODE !== 'true';
// hreflang only between pages that genuinely exist in both languages
const alts = { ...alternates, [lang]: pagePath } as Alternates;
const hasBoth = LANGS.every((l) => alts[l]);
const allCrumbs = crumbs ? [{ name: T.crumb.home, path: path(lang, 'home') }, ...crumbs] : null;
const jsonLd = [...schema, ...(allCrumbs ? [breadcrumbSchema(allCrumbs)] : [])];
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hasBoth && LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={absUrl(alts[l]!)} />)}
    {hasBoth && <link rel="alternate" hreflang="x-default" href={absUrl(alts.en!)} />}
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    {site.seo.googleSiteVerification && <meta name="google-site-verification" content={site.seo.googleSiteVerification} />}
    <meta name="theme-color" content="#0a1a5c" />
    <link rel="preload" href={fontHeading} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={asset('favicon/favicon-48.png')} sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href={asset('favicon/apple-touch-icon.png')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.company.brandName} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {hasBoth && LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <slot name="head" />
    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{T.nav.skip}</a>
    <Header lang={lang} currentPath={pagePath} alternates={alts} />
    <main id="main">
      {allCrumbs && <Breadcrumbs crumbs={allCrumbs} label={lang === 'ms' ? 'Laluan halaman' : 'Breadcrumb'} />}
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFloat lang={lang} message={waMessage ?? T.wa.home} />
  </body>
</html>
